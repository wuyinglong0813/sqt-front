<view class="info-page">
  <view class="info-state" wx:if="{{loading}}">正在读取企业资料…</view>
  <view class="info-card" wx:elif="{{errorMessage}}">
    <view class="info-title">企业资料暂未加载</view>
    <view class="info-description">{{errorMessage}}</view>
    <button class="info-button" bindtap="loadInfo">重新检查</button>
  </view>
  <block wx:else>
    <view class="info-heading">企业主体</view>
    <view class="info-card">
      <view class="info-company-name">{{company.name || '当前企业'}}</view>
      <view class="info-row"><text class="info-label">统一社会信用代码</text><text class="info-value">{{company.creditCode || '暂未录入'}}</text></view>
      <view class="info-row"><text class="info-label">法定代表人</text><text class="info-value">{{company.legalPersonName || '暂未录入'}}</text></view>
      <view class="info-row"><text class="info-label">企业认证状态</text><text class="info-value">{{certificationText}}</text></view>
    </view>

    <view class="info-heading">合同联系与银行信息</view>
    <view class="info-card">
      <block wx:if="{{editing}}">
        <view class="info-field"><view class="info-label">企业地址</view><input class="info-input" maxlength="256" value="{{businessInfo.registeredAddress}}" placeholder="请按营业执照填写地址" data-field="registeredAddress" bindinput="onBusinessInfoInput" /></view>
        <view class="info-field"><view class="info-label">联系电话</view><input class="info-input" maxlength="32" value="{{businessInfo.contactPhone}}" placeholder="企业联系电话" data-field="contactPhone" bindinput="onBusinessInfoInput" /></view>
        <view class="info-field"><view class="info-label">开户银行（选填）</view><input class="info-input" maxlength="128" value="{{businessInfo.bankName}}" placeholder="请输入开户银行" data-field="bankName" bindinput="onBusinessInfoInput" /></view>
        <view class="info-field"><view class="info-label">银行账号（选填）</view><input class="info-input" maxlength="64" value="{{businessInfo.bankAccount}}" placeholder="请输入银行账号" data-field="bankAccount" bindinput="onBusinessInfoInput" /></view>
        <button class="info-button" bindtap="saveBusinessInfo" loading="{{saving}}" disabled="{{saving}}">保存资料</button>
        <button class="info-button" bindtap="cancelBusinessInfo" disabled="{{saving}}">取消</button>
      </block>
      <block wx:else>
        <view class="info-row"><text class="info-label">企业地址</text><text class="info-value">{{company.registeredAddress || '暂未录入'}}</text></view>
        <view class="info-row"><text class="info-label">联系电话</text><text class="info-value">{{company.contactPhone || '暂未录入'}}</text></view>
        <view class="info-row"><text class="info-label">开户银行</text><text class="info-value">{{company.bankName || '暂未录入'}}</text></view>
        <view class="info-row"><text class="info-label">银行账号</text><text class="info-value">{{company.bankAccount || '暂未录入'}}</text></view>
        <button class="info-button" wx:if="{{canEditCompany}}" bindtap="editBusinessInfo">补充或修改资料</button>
      </block>
    </view>

    <view class="info-heading">我的企业身份</view>
    <view class="info-card">
      <view class="info-row"><text class="info-label">当前角色</text><text class="info-value">{{member.roleText || '企业成员'}}</text></view>
      <view class="info-description">企业角色与电子签平台的成员身份、用印权限分别核验。签署条件未齐时，可从企业首页的“我的签署待办”继续办理。</view>
    </view>

    <view class="info-heading" wx:if="{{canVerifyLegal}}">法人身份记录</view>
    <view class="info-card" wx:if="{{canVerifyLegal}}">
      <view class="info-title">本人是法人，核验已有记录</view>
      <view class="info-description">适用于历史入驻、尚未确认法人身份的本人账号。只有可信法人身份关联核验通过后，才会开通法人权限；普通成员无需办理。</view>
      <button class="info-button" bindtap="goLegalVerification">核验本人法人身份</button>
    </view>
  </block>
</view>
