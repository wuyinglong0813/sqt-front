<view class="page">
  <view class="hero">
    <view class="hero-copy"><view class="hero-label">企业库存台账</view><view class="hero-title">库存管理</view></view>
    <view class="metrics">
      <view><text>{{overview.warehouseCount}}</text><label>仓库</label></view>
      <view><text>{{overview.productCount}}</text><label>库存商品</label></view>
    </view>
  </view>

  <view class="section-head"><view><view class="section-title">仓库</view><view class="section-sub">点击仓库筛选库存</view></view><button bindtap="openCreate">＋ 新建仓库</button></view>
  <scroll-view class="warehouse-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{warehouses.length > 0}}">
    <view class="warehouse-row">
      <view class="warehouse-chip {{filterWarehouseId === '' ? 'active' : ''}}" data-id="" bindtap="selectFilterWarehouse">全部仓库</view>
      <view class="warehouse-chip {{filterWarehouseId == item.id ? 'active' : ''}}" wx:for="{{warehouses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectFilterWarehouse">{{item.name}}</view>
    </view>
  </scroll-view>
  <view class="warehouse-address" wx:if="{{filterWarehouseAddress}}">仓库地址：{{filterWarehouseAddress}}</view>
  <view class="empty-inline" wx:if="{{!loading && warehouses.length === 0}}">暂无仓库，先创建仓库后才能直接入库</view>

  <view class="section-head inventory-head"><view><view class="section-title">库存余额</view><view class="section-sub">按仓库、商品、规格汇总 · {{visibleBalances.length}} 条</view></view><button wx:if="{{overview.canManualInbound}}" bindtap="openInbound">＋ 手动入库</button></view>
  <view class="search-box">
    <image src="/images/icons/search.svg" mode="aspectFit"/>
    <input value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索商品名称、规格或仓库" confirm-type="search"/>
    <view class="clear-search" wx:if="{{searchKeyword}}" bindtap="clearSearch">清空</view>
  </view>
  <view class="balance-list" wx:if="{{visibleBalances.length > 0}}">
    <view class="table-hint"><text>左右滑动查看全部列</text><text>点击商品查看详情</text></view>
    <view class="inventory-table-shell">
      <view class="product-column">
        <view class="table-cell table-header">商品名称</view>
        <view class="table-cell product-cell" wx:for="{{visibleBalances}}" wx:key="id" data-index="{{index}}" bindtap="showBalanceDetail"><text>{{item.productName}}</text></view>
      </view>
      <scroll-view class="inventory-table-scroll" scroll-x enhanced show-scrollbar="{{true}}">
        <view class="inventory-table">
          <view class="table-row table-header"><view class="table-cell quantity-cell">库存数量</view><view class="table-cell unit-cell">单位</view><view class="table-cell specification-cell">规格型号</view><view class="table-cell price-cell">库存单价（元）</view><view class="table-cell amount-cell">库存金额（元）</view><view class="table-cell warehouse-cell">仓库</view></view>
          <view class="table-row" wx:for="{{visibleBalances}}" wx:key="id" data-index="{{index}}" bindtap="showBalanceDetail">
            <view class="table-cell quantity-cell">{{item.quantity}}</view><view class="table-cell unit-cell">{{item.baseUnit}}</view><view class="table-cell specification-cell">{{item.specification || '—'}}</view><view class="table-cell price-cell">{{item.unitPriceText}}</view><view class="table-cell amount-cell">{{item.inventoryAmountText}}</view><view class="table-cell warehouse-cell">{{item.warehouseName}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="table-footer">共 {{visibleBalances.length}} 条库存记录</view>
  </view>
  <view class="empty" wx:if="{{!loading && overview.balances.length > 0 && visibleBalances.length === 0}}"><view>没有匹配的库存</view><text>试试其他商品名称、规格或仓库</text><button class="reset-filters" bindtap="clearFilters">查看全部库存</button></view>
  <view class="empty" wx:if="{{!loading && overview.balances.length === 0}}"><image src="/images/icons/inventory.svg" mode="aspectFit"/><view>暂无库存</view><text>点击“手动入库”添加库存，或从销售单接收入库</text></view>
  <view class="loading" wx:if="{{loading}}">库存加载中...</view>

  <view class="mask" wx:if="{{showCreate}}" bindtap="closeCreate">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">新建仓库</view>
      <view class="field-label">仓库名称</view><input value="{{warehouseName}}" data-field="warehouseName" bindinput="onWarehouseInput" placeholder="例如：一号成品仓"/>
      <view class="field-label">仓库地址（选填）</view><input value="{{warehouseAddress}}" data-field="warehouseAddress" bindinput="onWarehouseInput" placeholder="请输入详细地址"/>
      <button loading="{{creating}}" disabled="{{creating}}" bindtap="createWarehouse">创建仓库</button>
    </view>
  </view>
  <view class="mask" wx:if="{{showInbound}}" bindtap="closeInbound">
    <scroll-view scroll-y class="sheet inbound-sheet" catchtap="noop">
      <view class="sheet-title">手动入库</view>
      <view class="field-label">入库仓库</view>
      <picker range="{{warehouses}}" range-key="name" value="{{warehouseIndex}}" bindchange="selectInboundWarehouse"><view class="warehouse-picker">{{warehouses[warehouseIndex].name}} ⌄</view></picker>
      <view class="field-label">商品名称</view><input type="text" value="{{inbound.productName}}" data-field="productName" bindinput="onInboundInput" placeholder="商品名称" maxlength="500"/>
      <view class="field-label">规格（选填）</view><input type="text" value="{{inbound.specification}}" data-field="specification" bindinput="onInboundInput" placeholder="规格（选填）" maxlength="500"/>
      <view class="field-label">单位，如件、吨</view><input type="text" value="{{inbound.baseUnit}}" data-field="baseUnit" bindinput="onInboundInput" placeholder="单位，如件、吨" maxlength="500"/>
      <view class="field-label">入库数量</view><input type="digit" value="{{inbound.quantity}}" data-field="quantity" bindinput="onInboundInput" placeholder="入库数量" maxlength="500"/>
      <view class="field-label">入库单价（元，可填 0）</view><input type="digit" value="{{inbound.unitPrice}}" data-field="unitPrice" bindinput="onInboundInput" placeholder="入库单价（元，可填 0）" maxlength="500"/>
      <view class="field-label">入库备注（选填）</view><input type="text" value="{{inbound.remark}}" data-field="remark" bindinput="onInboundInput" placeholder="入库备注（选填）" maxlength="500"/>
      <button loading="{{savingInbound}}" disabled="{{savingInbound}}" bindtap="saveInbound">确认入库</button>
    </scroll-view>
  </view>
</view>
