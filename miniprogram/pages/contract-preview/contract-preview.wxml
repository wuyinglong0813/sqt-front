<view class="page">
  <!-- 合同信息头 -->
  <view class="contract-header">
    <view class="ch-number-row">
      <view class="ch-number" wx:if="{{contract}}">{{contract.contractNo || contract.id}}</view>
      <view class="contract-more" wx:if="{{contract && canViewContractContent}}">
        <button class="contract-more-button" bindtap="toggleContractMore" aria-label="更多合同操作" aria-expanded="{{showContractMore}}">更多</button>
        <view class="contract-more-menu" wx:if="{{showContractMore}}">
          <view class="contract-more-item" bindtap="openMemoEditor"><image src="/images/icons/personal-note.svg" mode="aspectFit"/><view><view class="contract-more-title">我的进展</view><view class="contract-more-tip">仅当前账号可见</view></view><text>›</text></view>
          <view class="contract-more-divider" wx:if="{{canCancelContract || canEditContract || canDeleteContract || canRequestEnd || canRequestVoid || (activeContractAction && activeContractAction.bizType === 'CONTRACT' && activeContractAction.status === 'PENDING' && activeContractAction.canCancel)}}"></view>
          <button class="contract-more-action" wx:if="{{canEditContract}}" disabled="{{contractActionLoading}}" data-action="edit" bindtap="runContractMoreAction">修改并重新发起</button>
          <button class="contract-more-action" wx:if="{{canCancelContract}}" disabled="{{contractActionLoading}}" data-action="withdraw" bindtap="runContractMoreAction">撤回合同</button>
          <button class="contract-more-action" wx:if="{{canRequestEnd}}" disabled="{{contractActionLoading}}" data-action="end" bindtap="runContractMoreAction">申请结束</button>
          <button class="contract-more-action caution" wx:if="{{canRequestVoid}}" disabled="{{contractActionLoading}}" data-action="void" bindtap="runContractMoreAction">申请作废</button>
          <button class="contract-more-action" wx:if="{{activeContractAction && activeContractAction.bizType === 'CONTRACT' && activeContractAction.status === 'PENDING' && activeContractAction.canCancel}}" disabled="{{contractActionLoading}}" data-action="cancelRequest" bindtap="runContractMoreAction">撤回申请</button>
          <button class="contract-more-action danger" wx:if="{{canDeleteContract}}" disabled="{{contractActionLoading}}" data-action="delete" bindtap="runContractMoreAction">删除合同</button>
        </view>
      </view>
    </view>
    <view class="ch-name">{{contractName}}</view>
    <view class="ch-party">与 {{counterpartyName}} 的合同</view>
    <view class="contract-amount-summary" wx:if="{{contract}}"><view><view class="contract-amount-label">销售单累计金额</view><view class="contract-amount-number">¥{{contract.salesAmountText}}</view></view><view><view class="contract-amount-label">合同金额</view><view class="contract-amount-number">¥{{contract.contractAmountText}}</view></view></view>
    <view class="contract-amount-note" wx:if="{{contract}}">退货 ¥{{contract.returnAmountText}} · 净销售 ¥{{contract.netSalesAmountText}}</view>
  </view>

  <view class="contract-more-mask" wx:if="{{showContractMore}}" bindtap="closeContractMore"></view>

  <view class="contract-manage-actions" wx:if="{{canSignContract || (activeContractAction && activeContractAction.bizType === 'CONTRACT' && activeContractAction.canReview)}}">
    <button class="contract-manage-button primary" wx:if="{{canSignContract}}" disabled="{{contractActionLoading}}" bindtap="signContract">{{signButtonText}}</button>
    <button class="contract-manage-button ghost" wx:if="{{activeContractAction && activeContractAction.bizType === 'CONTRACT' && activeContractAction.canReview}}" data-decision="REJECT" bindtap="reviewContractAction">拒绝申请</button>
    <button class="contract-manage-button danger" wx:if="{{activeContractAction && activeContractAction.bizType === 'CONTRACT' && activeContractAction.canReview}}" data-decision="APPROVE" bindtap="reviewContractAction">确认{{activeContractAction.actionText}}</button>
  </view>

  <view class="contract-lock-notice terminal" wx:if="{{signingTimedOut}}">{{contract.statusText}}</view>

  <view class="contract-lock-notice" wx:if="{{activeContractAction}}">
    <view class="contract-lock-title">{{activeContractAction.targetText}}{{activeContractAction.actionText}}申请待处理</view>
    <view>原因：{{activeContractAction.reason}}</view>
    <view>处理完成前，合同及全部履约资料暂时只读。</view>
  </view>
  <view class="contract-lock-notice terminal" wx:elif="{{contract && (contract.status === 'COMPLETED' || contract.status === 'VOIDED')}}">
    该合同{{contract.status === 'COMPLETED' ? '已结束，仅允许查看和下载。' : '已作废，正文及履约资料仅允许查看和下载，可从我方列表删除。'}}
  </view>

  <!-- 合同正文与履约资料两个一级入口。 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="key"
      data-tab="{{item.key}}" bindtap="switchTab">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- ====== 合同详情 Tab ====== -->
  <block wx:if="{{activeTab === 'detail'}}">
    <view class="detail-loading" wx:if="{{!contract}}">
      <view class="loading-text">加载中...</view>
    </view>

    <view class="pdf-viewer" wx:else>
      <view class="signed-preview-group" wx:if="{{signedContractArchived}}">
        <view class="signed-preview-card" wx:for="{{signedPreviewPages}}" wx:key="pageNumber">
          <image
            class="signed-preview-image"
            wx:if="{{item.filePath && !item.error}}"
            src="{{item.filePath}}"
            mode="widthFix"
            lazy-load="{{true}}"
            data-page="{{item.pageNumber}}"
            bindtap="openContractPdf"
            binderror="onSignedPreviewError"
          />
          <view class="signed-preview-loading" wx:elif="{{item.loading}}">
            <view class="signed-preview-spinner"></view>
            <view class="signed-preview-loading-title">加载中…</view>
          </view>
          <view class="signed-preview-error" wx:else>
            <view class="signed-preview-error-title">第 {{item.pageNumber}} 页加载失败</view>
            <view class="signed-preview-error-desc">{{item.error || '请重试，或点击下方“查看 PDF”'}}</view>
            <button wx:if="{{!signedPreviewVersionChanged}}" data-page="{{item.pageNumber}}" disabled="{{signedPreviewLoading}}" bindtap="retrySignedContractPreview">重新加载此页</button>
          </view>
        </view>
        <view class="signed-preview-loading signed-preview-card" wx:if="{{signedPreviewLoading && signedPreviewPages.length === 0}}">
          <view class="signed-preview-spinner"></view>
          <view class="signed-preview-loading-title">合同加载中…</view>
        </view>
        <image
          class="signed-preview-image"
          wx:elif="{{signedPreviewLegacy && signedPreviewFilePath}}"
          src="{{signedPreviewFilePath}}"
          mode="widthFix"
          bindtap="openContractPdf"
          binderror="onSignedPreviewError"
        />
        <view class="signed-preview-error signed-preview-card" wx:elif="{{signedPreviewPages.length === 0}}">
          <view class="signed-preview-error-title">合同加载失败</view>
          <view class="signed-preview-error-desc">{{signedPreviewError || '请重试，或点击下方“查看 PDF”'}}</view>
          <button bindtap="retrySignedContractPreview">重新加载合同</button>
        </view>
        <view class="signed-preview-legacy-note" wx:if="{{signedPreviewLegacy}}">当前为签章页预览，完整内容请查看 PDF。</view>
        <button class="signed-preview-reload" wx:if="{{signedPreviewPages.length > 0 && !signedPreviewLoading && !signedPreviewReady}}" bindtap="retrySignedContractPreview">重新加载全部页面</button>
      </view>

      <view class="pdf-paper" wx:else bindtap="openContractPdf">
        <view class="pdf-paper-title">{{pdfTitle}}</view>
        <view class="pdf-paper-head">
          <view>
            <view>供方：{{pdfSupplier}}</view>
            <view>需方：{{pdfBuyer}}</view>
          </view>
          <view>
            <view>合同编号：{{contract.contractNo || contract.id}}</view>
            <view>日期：{{pdfDate}}</view>
          </view>
        </view>
        <view class="pdf-section-line">{{contractTableTitle}}</view>
        <view class="pdf-mini-table" wx:if="{{contractTableColumns.length > 0}}">
          <view class="pdf-mini-row pdf-mini-header">
            <view wx:for="{{contractTableColumns}}" wx:for-item="column" wx:key="*this">{{column}}</view>
          </view>
          <view class="pdf-mini-row" wx:for="{{contractTableRows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
            <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="cellIndex" wx:key="cellIndex">{{cell}}</view>
          </view>
          <view class="pdf-mini-empty" wx:if="{{contractTableRows.length === 0}}">暂无商品明细</view>
        </view>
        <view class="pdf-contract-total" wx:if="{{contractTotalAmount}}">
          {{contractFees.length > 0 ? '商品小计' : '合计'}}：¥{{contractTotalAmount}} <text wx:if="{{contractTotalAmountCn}}">（{{contractTotalAmountCn}}）</text>
        </view>
        <view class="pdf-fee-section" wx:if="{{contractFees.length > 0}}">
          <view class="pdf-fee-title">其他费用（不计入库存）</view>
          <view class="pdf-fee-row" wx:for="{{contractFees}}" wx:key="index">
            <text>{{item.feeType}}</text><text>¥{{item.amount}}</text><text>{{item.remark || '—'}}</text>
          </view>
          <view class="pdf-fee-total">费用小计：¥{{contractFeeTotal}}</view>
          <view class="pdf-fee-grand">合同总额：¥{{contract.amount}}</view>
        </view>
        <view class="pdf-clause-content" wx:for="{{contractClauses}}" wx:key="label">
          <view class="pdf-clause-title">{{item.label}}</view>
          <view class="pdf-clause-text">{{item.content || '—'}}</view>
        </view>
        <view class="pdf-sign-table">
          <view class="pdf-party-sign">
            <text class="pdf-party-role">供方</text>
            <text class="pdf-party-name">{{pdfSupplier || '—'}}</text>
            <view class="pdf-seal-state">
              <text>{{pdfSupplierSignText}}</text>
              <text>—</text>
            </view>
          </view>
          <view class="pdf-party-sign">
            <text class="pdf-party-role">需方</text>
            <text class="pdf-party-name">{{pdfBuyer || '—'}}</text>
            <view class="pdf-seal-state">
              <text>{{pdfBuyerSignText}}</text>
              <text>—</text>
            </view>
          </view>
        </view>
      </view>

      <view class="pdf-actions">
        <button class="pdf-button primary" loading="{{pdfLoading}}" disabled="{{pdfLoading}}" bindtap="openContractPdf">查看 PDF</button>
        <button class="pdf-button secondary" loading="{{pdfLoading}}" disabled="{{pdfLoading}}" bindtap="downloadContractPdf">下载 PDF</button>
      </view>

    </view>
  </block>

  <!-- 分类仅保留全部与新增，条目点击进入内容。 -->
  <block wx:if="{{activeTab === 'fulfillment'}}">
    <view id="fulfillment-panel" class="fulfillment-tools">
      <scroll-view class="fulfillment-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{fulfillmentTabAnchor}}" scroll-with-animation>
        <view class="fulfillment-filters"><view id="fulfillment-filter-{{item.key}}" class="fulfillment-filter {{fulfillmentFilter === item.key ? 'selected' : ''}}" wx:for="{{fulfillmentTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="filterFulfillment">{{item.label}}<text wx:if="{{item.count}}">{{item.count}}</text></view></view>
      </scroll-view>
    </view>
    <block wx:if="{{fulfillmentFilter !== 'ALL'}}">
      <view class="fulfillment-category-head"><view>{{fulfillmentCategoryLabel}}</view><button class="fulfillment-create-plus" wx:if="{{fulfillmentCreateLabel}}" disabled="{{attachmentUploading || logisticsUploading || documentEditorSubmitting}}" bindtap="openAddFulfillment" aria-label="{{fulfillmentCreateLabel}}"><view class="fulfillment-plus-icon"></view></button></view>
      <view class="fulfillment-search-row">
        <view class="fulfillment-search"><image src="/images/icons/search.svg" mode="aspectFit"/><input value="{{fulfillmentSearch}}" bindinput="onFulfillmentSearch" placeholder="搜索单号、文件名或企业" confirm-type="search"/><view class="fulfillment-search-clear" wx:if="{{fulfillmentSearch}}" bindtap="clearFulfillmentSearch">×</view></view>
        <picker wx:if="{{fulfillmentShowStatus}}" range="{{fulfillmentStatusChoices}}" range-key="label" value="{{fulfillmentStatusIndex}}" bindchange="onFulfillmentStatusChange"><view class="fulfillment-status-filter">{{fulfillmentStatusChoices[fulfillmentStatusIndex].label}}<text>⌄</text></view></picker>
      </view>
      <view class="fulfillment-result-count" wx:if="{{fulfillmentHasFilters}}">找到 {{fulfillmentMatchCount}} 条</view>
    </block>
    <view class="fulfillment-empty" wx:if="{{!visibleFulfillmentGroups.length}}"><view>{{fulfillmentLoading ? '正在加载资料…' : '暂无履约资料'}}</view></view>
    <view class="fulfillment-section" wx:for="{{visibleFulfillmentGroups}}" wx:for-item="group" wx:key="key">
      <view class="fulfillment-group-head" wx:if="{{fulfillmentFilter === 'ALL'}}">
        <view class="fulfillment-group-title">{{group.label}}</view>
        <button class="fulfillment-create-plus" wx:if="{{group.createLabel}}" data-kind="{{group.key}}" disabled="{{attachmentUploading || logisticsUploading || documentEditorSubmitting}}" catchtap="openAddFulfillment" aria-label="{{group.createLabel}}"><view class="fulfillment-plus-icon"></view></button>
      </view>
      <view class="record-row" wx:for="{{group.items}}" wx:for-item="record" wx:key="id" data-kind="{{group.key}}" data-id="{{record.id}}" bindtap="openFulfillmentRecord">
        <view class="record-mark {{group.tone}}">{{group.mark}}</view>
        <view class="record-body">
          <view class="record-heading"><view class="record-title">{{record.title}}</view><text class="record-amount" wx:if="{{record.amountText}}">{{record.amountText}}</text></view>
          <view class="record-meta"><text class="record-status status-{{record.status}}" wx:if="{{record.statusText}}">{{record.statusText}}</text><text wx:if="{{record.dateText}}">{{record.dateText}}</text><text class="record-company" wx:if="{{record.companyName}}">{{record.companyName}}</text></view>
          <view class="record-reason" wx:if="{{record.rejectedReason}}">{{record.rejectedReason}}</view>
        </view>
        <text class="record-arrow">›</text>
      </view>
      <view class="fulfillment-error" wx:if="{{group.errorText}}"><text>{{group.errorText}}</text><button data-kind="{{group.key}}" bindtap="retryFulfillmentSection">重试</button></view>
      <view class="fulfillment-empty compact {{fulfillmentFilter === 'ALL' ? 'overview-empty' : ''}}" wx:elif="{{!group.items.length}}">{{fulfillmentHasFilters ? '没有符合条件的资料' : '暂无' + group.label}}</view>
      <view class="fulfillment-view-all" wx:if="{{fulfillmentFilter === 'ALL'}}" data-key="{{group.key}}" bindtap="filterFulfillment">全部 {{group.count}} 条<text>›</text></view>
    </view>
    <button class="fulfillment-show-more" wx:if="{{fulfillmentHasMore}}" bindtap="showMoreFulfillment">查看更多</button>
  </block>

  <view class="fulfillment-detail-page" wx:if="{{showFulfillmentDetail && fulfillmentDetail}}">
    <view class="fulfillment-detail-header">
      <button class="fulfillment-detail-back" bindtap="closeFulfillmentDetail" aria-label="返回履约资料">‹</button>
      <view class="fulfillment-detail-label">{{fulfillmentDetail.label}}</view>
      <button class="fulfillment-detail-more" wx:if="{{fulfillmentDetail.hasMoreActions}}" disabled="{{fulfillmentDetailPdfFileLoading || attachmentLoading || contractActionLoading}}" bindtap="openFulfillmentDetailMore" aria-label="更多资料操作">更多</button><view class="fulfillment-detail-more-placeholder" wx:else></view>
    </view>
    <scroll-view class="fulfillment-detail-body" scroll-y>
      <view class="fulfillment-detail-content">
        <block wx:if="{{fulfillmentDetail.isPdf}}">
          <view class="fulfillment-pdf-page" wx:for="{{fulfillmentDetailPdfPages}}" wx:key="pageNumber">
            <image class="fulfillment-pdf-image" wx:if="{{item.filePath && !item.error}}" src="{{item.filePath}}" mode="widthFix" lazy-load data-page="{{item.pageNumber}}" bindtap="openFulfillmentDetailPdf" binderror="onFulfillmentPdfImageError"/>
            <view class="fulfillment-pdf-state" wx:elif="{{item.loading}}">加载中…</view>
            <view class="fulfillment-pdf-state" wx:else><view>{{item.error || '此页加载失败'}}</view><button wx:if="{{!fulfillmentDetailPdfVersionChanged}}" data-page="{{item.pageNumber}}" disabled="{{fulfillmentDetailPdfLoading}}" bindtap="retryFulfillmentDetailPdf">重新加载此页</button></view>
          </view>
          <view class="fulfillment-pdf-state" wx:if="{{!fulfillmentDetailPdfPages.length}}"><view>{{fulfillmentDetailPdfLoading ? '加载中…' : fulfillmentDetailPdfError || 'PDF 暂时无法显示'}}</view><button wx:if="{{!fulfillmentDetailPdfLoading && !fulfillmentDetailPdfVersionChanged}}" bindtap="retryFulfillmentDetailPdf">重新加载</button></view>
          <button class="fulfillment-pdf-retry" wx:if="{{fulfillmentDetailPdfVersionChanged}}" disabled="{{fulfillmentDetailPdfLoading}}" bindtap="retryFulfillmentDetailPdf">重新加载全部页面</button>
          <view class="fulfillment-pdf-actions"><button class="primary" loading="{{fulfillmentDetailPdfFileLoading}}" disabled="{{fulfillmentDetailPdfFileLoading}}" bindtap="openFulfillmentDetailPdf">查看 PDF</button><button class="secondary" data-download="{{true}}" loading="{{fulfillmentDetailPdfFileLoading}}" disabled="{{fulfillmentDetailPdfFileLoading}}" bindtap="openFulfillmentDetailPdf">下载 PDF</button></view>
          <block wx:for="{{fulfillmentDetail.fields}}" wx:key="label"><view class="fulfillment-pdf-notes" wx:if="{{item.label === '作废原因' || item.label === '驳回原因'}}">{{item.label}}：{{item.value}}</view></block>
        </block>
        <block wx:else>
          <view class="fulfillment-detail-title">{{fulfillmentDetail.title}}</view>
          <view class="fulfillment-detail-summary"><text class="fulfillment-detail-amount" wx:if="{{fulfillmentDetail.amountText}}">{{fulfillmentDetail.amountText}}</text><text class="record-status status-{{fulfillmentDetail.status}}" wx:if="{{fulfillmentDetail.statusText}}">{{fulfillmentDetail.statusText}}</text></view>
          <image class="fulfillment-detail-image" wx:if="{{fulfillmentDetailImage}}" src="{{fulfillmentDetailImage}}" mode="widthFix" bindtap="viewFulfillmentDetailFile" binderror="onFulfillmentDetailImageError"/>
          <view class="fulfillment-detail-file" wx:elif="{{fulfillmentDetail.isImage}}"><text>{{fulfillmentDetailImageLoading ? '图片加载中…' : fulfillmentDetailImageError}}</text><button wx:if="{{fulfillmentDetailImageError}}" bindtap="loadFulfillmentDetailImage">重新加载</button></view>
          <view class="fulfillment-detail-file" wx:else bindtap="viewFulfillmentDetailFile"><view class="fulfillment-file-icon">▤</view><view class="fulfillment-file-open">查看原文件 ›</view></view>
          <view class="fulfillment-detail-fields" wx:if="{{fulfillmentDetail.fields.length}}"><view class="fulfillment-detail-field" wx:for="{{fulfillmentDetail.fields}}" wx:key="label"><text>{{item.label}}</text><view>{{item.value}}</view></view></view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="record-menu-mask" wx:if="{{showFulfillmentMenu}}" bindtap="closeFulfillmentMenu">
    <view class="record-menu-sheet" catchtap="noop">
      <view class="record-menu-handle"></view>
      <view class="record-menu-heading"><view class="record-menu-title">{{fulfillmentMenuTitle}}</view><view class="record-menu-close" bindtap="closeFulfillmentMenu">×</view></view>
      <view class="record-menu-subtitle" wx:if="{{fulfillmentMenuSubtitle}}">{{fulfillmentMenuSubtitle}}</view>
      <scroll-view class="record-menu-list" scroll-y>
        <button class="record-menu-action {{item.tone || ''}}" wx:for="{{fulfillmentMenuActions}}" wx:key="key" data-key="{{item.key}}" bindtap="runFulfillmentAction">{{item.label}}</button>
      </scroll-view>
      <button class="record-menu-cancel" bindtap="closeFulfillmentMenu">取消</button>
    </view>
  </view>

  <!-- 转款凭证金额确认面板。 -->
  <view class="payment-amount-mask" wx:if="{{showPaymentAmountEditor}}" bindtap="closePaymentAmountEditor">
    <view class="payment-amount-sheet" catchtap="noop">
      <view class="payment-sheet-handle"></view>
      <view class="payment-sheet-head">
        <view class="payment-sheet-icon">¥</view>
        <view class="payment-sheet-copy">
          <view class="payment-sheet-title">填写转款金额</view>
          <view class="payment-sheet-sub">金额将随凭证展示给合同双方</view>
        </view>
        <view class="payment-sheet-close" bindtap="closePaymentAmountEditor">×</view>
      </view>

      <view class="payment-file-card">
        <view class="payment-file-icon">凭</view>
        <view class="payment-file-copy">
          <view class="payment-file-label">已选择转款凭证</view>
          <view class="payment-file-name">{{pendingPaymentAttachment.originalName}}</view>
        </view>
        <view class="payment-file-check">✓</view>
      </view>

      <view class="payment-field-label">本次转款金额</view>
      <view class="payment-amount-field {{paymentAmountError ? 'error' : ''}}">
        <text class="payment-currency">¥</text>
        <input
          class="payment-amount-input"
          type="digit"
          maxlength="19"
          value="{{paymentAmount}}"
          placeholder="0.00"
          placeholder-class="payment-amount-placeholder"
          focus="{{showPaymentAmountEditor}}"
          confirm-type="done"
          bindinput="onPaymentAmountInput"
          bindconfirm="confirmPaymentAttachmentUpload"
        />
        <text class="payment-unit">元</text>
      </view>
      <view class="payment-field-message {{paymentAmountError ? 'error' : ''}}">
        {{paymentAmountError || '请输入凭证对应的实际转款金额，最多保留两位小数'}}
      </view>

      <view class="payment-field-label">转款日期</view>
      <picker mode="date" value="{{paymentDate}}" bindchange="onPaymentDateChange">
        <view class="payment-text-field">{{paymentDate}} <text>›</text></view>
      </picker>

      <view class="payment-sheet-actions">
        <button class="payment-cancel" bindtap="closePaymentAmountEditor">取消</button>
        <button class="payment-confirm" bindtap="confirmPaymentAttachmentUpload">提交对方确认</button>
      </view>
    </view>
  </view>

  <!-- 发票结构化信息面板。 -->
  <view class="payment-amount-mask" wx:if="{{showInvoiceEditor}}" bindtap="closeInvoiceEditor">
    <view class="payment-amount-sheet" catchtap="noop">
      <view class="payment-sheet-handle"></view>
      <view class="payment-sheet-head">
        <view class="payment-sheet-icon">票</view>
        <view class="payment-sheet-copy"><view class="payment-sheet-title">填写发票信息</view><view class="payment-sheet-sub">对方确认后自动更新客户对账</view></view>
        <view class="payment-sheet-close" bindtap="closeInvoiceEditor">×</view>
      </view>
      <view class="payment-file-card"><view class="payment-file-icon">票</view><view class="payment-file-copy"><view class="payment-file-label">已选择发票文件</view><view class="payment-file-name">{{pendingInvoiceAttachment.originalName}}</view></view><view class="payment-file-check">✓</view></view>
      <view class="payment-field-label">开票日期</view>
      <picker mode="date" value="{{invoiceDate}}" bindchange="onInvoiceDateChange"><view class="payment-text-field">{{invoiceDate}} <text>›</text></view></picker>
      <view class="payment-field-label">发票金额</view>
      <view class="payment-amount-field {{invoiceError ? 'error' : ''}}"><text class="payment-currency">¥</text><input class="payment-amount-input" type="digit" maxlength="19" value="{{invoiceAmount}}" placeholder="0.00" bindinput="onInvoiceAmountInput"/><text class="payment-unit">元</text></view>
      <view class="payment-field-message {{invoiceError ? 'error' : ''}}">{{invoiceError || '日期和金额将在确认后计入对账'}}</view>
      <view class="payment-sheet-actions"><button class="payment-cancel" bindtap="closeInvoiceEditor">取消</button><button class="payment-confirm" bindtap="confirmInvoiceUpload">提交对方确认</button></view>
    </view>
  </view>

  <view class="payment-signature-mask" wx:if="{{showPaymentConfirmationSignature}}" bindtap="closePaymentConfirmationSignature">
    <view class="payment-signature-sheet" catchtap="noop">
      <view class="payment-signature-handle"></view>
      <view class="payment-signature-head">
        <view><view class="payment-signature-title">确认转款凭证</view><view class="payment-signature-signer">确认人：{{paymentConfirmationSignerName}}</view></view>
        <view class="payment-signature-close" bindtap="closePaymentConfirmationSignature">×</view>
      </view>
      <view class="payment-signature-copy">查看凭证不需要签名；只有点击“确认通过”时才需要手写签名。</view>
      <view class="payment-signature-canvas-wrap">
        <canvas type="2d" id="contractPaymentSignatureCanvas" class="payment-signature-canvas" disable-scroll="true" bindtouchstart="onPaymentSignatureTouchStart" catchtouchmove="onPaymentSignatureTouchMove" bindtouchend="onPaymentSignatureTouchEnd" bindtouchcancel="onPaymentSignatureTouchEnd"></canvas>
        <view class="payment-signature-placeholder">请在此区域签名</view>
      </view>
      <view class="payment-signature-actions">
        <button class="payment-signature-clear" disabled="{{attachmentLoading}}" bindtap="clearPaymentSignature">清除重签</button>
        <button class="payment-signature-confirm" loading="{{attachmentLoading}}" disabled="{{attachmentLoading}}" bindtap="confirmPaymentSignature">签字并确认通过</button>
      </view>
    </view>
  </view>

  <!-- 私人进展收在更多菜单中，合同主内容不展示笔记摘要。 -->
  <view class="memo-mask" wx:if="{{showMemoEditor}}" bindtap="closeMemoEditor">
    <view class="memo-sheet" catchtap="noop">
      <view class="memo-sheet-handle"></view>
      <view class="memo-head">
        <view><view class="memo-title">我的进展</view><view class="memo-tip">仅当前账号可见，不与同事或合同对方共享</view></view>
        <view class="memo-close" bindtap="closeMemoEditor">×</view>
      </view>
      <view class="memo-context">{{contractName}} · {{counterpartyName}}</view>
      <view class="memo-load-state" wx:if="{{memoLoading}}">正在读取我的进展…</view>
      <view class="memo-load-state" wx:elif="{{memoLoadError}}"><view>{{memoLoadError}}</view><button bindtap="retryContractMemo">重新加载</button></view>
      <block wx:else>
        <scroll-view class="memo-readonly" scroll-y wx:if="{{contractReadOnly}}"><text selectable>{{personalMemo || '尚未记录进展'}}</text></scroll-view>
        <textarea wx:else class="memo-input" maxlength="4000" value="{{memoDraft}}" disabled="{{memoSaving}}" bindinput="onMemoInput" placeholder="记录本次沟通、下一步安排或待跟进事项…" focus="{{showMemoEditor}}" adjust-position="true" cursor-spacing="28" show-confirm-bar="false"/>
        <view class="memo-sheet-meta"><text>{{contractReadOnly ? '合同当前只读' : memoDraft.length + ' / 4000'}}</text><text wx:if="{{memoUpdatedAt}}">更新于 {{memoUpdatedAt}}</text></view>
      </block>
      <button wx:if="{{!contractReadOnly}}" class="memo-save" loading="{{memoSaving}}" disabled="{{memoSaving || memoLoading || memoLoadError}}" bindtap="saveContractMemo">保存进展</button>
    </view>
  </view>

  <!-- 销售单创建编辑器 -->
  <view class="document-editor-page" wx:if="{{showDocumentEditor}}">
    <view class="document-editor-header">
      <view class="document-editor-close" bindtap="closeDocumentEditor">取消</view>
      <view class="document-editor-title">{{createAsDraft ? '创建' + documentEditorLabel + '草稿' : '创建' + documentEditorLabel}}</view>
      <view class="document-editor-close placeholder">取消</view>
    </view>

    <scroll-view class="document-editor-body" scroll-y>
      <view class="document-party-bar">
        <view class="document-party-item">
          <view class="document-party-avatar my">{{documentCompanyName[0]}}</view>
          <view class="document-party-name">{{documentCompanyName}}</view>
          <view class="document-party-tag">制单方</view>
        </view>
        <view class="document-party-vs"><image src="/images/logo.png" mode="aspectFit"/></view>
        <view class="document-party-item">
          <view class="document-party-avatar counterparty">{{documentCounterpartyName[0]}}</view>
          <view class="document-party-name">{{documentCounterpartyName}}</view>
          <view class="document-party-tag">往来单位</view>
        </view>
      </view>

      <view class="document-edit-card">
        <view class="document-form-label">{{documentEditorLabel}}模板</view>
        <picker mode="selector" range="{{documentTemplates}}" range-key="name" value="{{documentTemplateIndex}}" bindchange="onDocumentTemplateChange">
          <view class="document-template-picker {{documentTemplateIndex < 0 ? 'placeholder' : ''}}">
            {{documentTemplates[documentTemplateIndex] ? documentTemplates[documentTemplateIndex].name : '请选择模板'}} ▾
          </view>
        </picker>
      </view>

      <block wx:if="{{documentEditorReady}}">
        <view class="document-edit-card">
          <view class="document-form-label">{{documentEditorLabel}}名称</view>
          <input class="document-name-input" value="{{documentTitle}}" data-field="documentTitle" bindinput="onDocumentFieldInput" placeholder="请输入单据名称"/>
        </view>

        <view class="document-edit-card document-title-card">
          <view class="document-preview-title">{{documentTitle || documentEditorLabel}}</view>
          <view class="document-preview-no">单据编号：创建时自动生成</view>
        </view>

        <view class="document-edit-card">
          <view class="document-edit-section-title">单据信息</view>
          <view class="document-field-row">
            <view class="document-field-label">制单企业</view>
            <input class="document-field-input" value="{{documentCompanyName}}" data-field="documentCompanyName" bindinput="onDocumentFieldInput" placeholder="请输入制单企业"/>
          </view>
          <view class="document-field-row">
            <view class="document-field-label">往来单位</view>
            <input class="document-field-input" value="{{documentCounterpartyName}}" data-field="documentCounterpartyName" bindinput="onDocumentFieldInput" placeholder="请输入往来单位"/>
          </view>
          <view class="document-field-row">
            <view class="document-field-label">关联合同</view>
            <input class="document-field-input" value="{{documentContractNo}}" data-field="documentContractNo" bindinput="onDocumentFieldInput" placeholder="请输入合同编号"/>
          </view>
          <view class="document-field-row">
            <view class="document-field-label">单据日期</view>
            <picker class="document-field-picker" mode="date" value="{{documentDate}}" bindchange="onDocumentDateChange">
              <view class="document-field-value">{{documentDate || '请选择日期'}}</view>
            </picker>
          </view>
        </view>

        <view class="document-edit-card">
          <view class="document-edit-section-head">
            <view><view class="document-edit-section-title">商品明细</view><view class="document-edit-hint">左右滑动可编辑全部列</view></view>
          </view>
          <scroll-view class="document-table-scroll" scroll-x enable-flex>
            <view class="document-edit-table" style="width: {{documentColumns.length * 190 + 78}}rpx;">
              <view class="document-edit-table-row header">
                <view class="document-edit-cell" wx:for="{{documentColumns}}" wx:key="*this">{{item}}</view>
                <view class="document-edit-cell action"></view>
              </view>
              <view class="document-edit-table-row {{documentRowTypes[rowIndex] === 'FEE' ? 'fee-row' : ''}}" wx:for="{{documentRows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
                <view class="document-edit-cell" wx:for="{{documentColumns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="*this">
                  <input class="document-cell-input" value="{{row[columnIndex]}}" data-row="{{rowIndex}}" data-col="{{columnIndex}}" bindinput="onDocumentCellInput"/>
                </view>
                <view class="document-edit-cell action"><view class="document-row-delete" data-index="{{rowIndex}}" bindtap="deleteDocumentRow">×</view></view>
              </view>
            </view>
          </scroll-view>
          <view class="document-fee-hint" wx:if="{{documentHasFees}}">浅橙色行为合同费用项，计入金额但不进入库存。</view>
          <view class="document-row-add" bindtap="addDocumentRow">＋ 添加商品行</view>
          <view class="document-total-field" wx:if="{{documentEditorType === 'SALES_ORDER' || documentEditorType === 'RETURN_ORDER'}}">
            <view class="document-total-label">合计：</view>
            <view class="document-total-value">¥{{documentTotalAmount}}</view>
          </view>
        </view>
      </block>

      <view class="document-editor-empty" wx:else>
        <view class="document-editor-empty-icon">▤</view>
        <view>请先选择一个{{documentEditorLabel}}模板</view>
      </view>
      <view class="document-editor-safe"></view>
    </scroll-view>

    <view class="document-editor-actions" wx:if="{{documentEditorReady}}">
      <button class="document-editor-button submit" loading="{{documentEditorSubmitting}}" disabled="{{documentEditorSubmitting}}" bindtap="submitBusinessDocument">{{createAsDraft ? '保存草稿' : '创建并发布'}}</button>
    </view>
  </view>

  <!-- 合同生效后的项目账套归集引导 -->
  <view class="project-ledger-prompt-mask" wx:if="{{showProjectLedgerPrompt}}" bindtap="closeProjectLedgerPrompt">
    <view class="project-ledger-prompt" catchtap="noop">
      <view class="project-ledger-prompt-accent"></view>
      <view class="project-ledger-prompt-close" bindtap="closeProjectLedgerPrompt">×</view>
      <view class="project-ledger-prompt-icon">
        <view class="project-ledger-prompt-check">✓</view>
      </view>
      <view class="project-ledger-prompt-kicker">合同已签署生效</view>
      <view class="project-ledger-prompt-title">归入项目账套</view>
      <view class="project-ledger-prompt-contract">{{projectLedgerContractName}}</view>
      <view class="project-ledger-prompt-desc" wx:if="{{projectLedgerHasProjects}}">选择归属后，合同金额和后续履约数据会自动汇总到项目中。</view>
      <view class="project-ledger-prompt-desc" wx:else>创建项目账套后，可统一查看合同金额、成本、收入和预计利润。</view>

      <view class="project-ledger-choice primary" wx:if="{{projectLedgerHasProjects}}" data-action="assign" bindtap="chooseProjectLedgerAction">
        <view class="project-ledger-choice-icon folder"><view></view></view>
        <view class="project-ledger-choice-copy">
          <view class="project-ledger-choice-title">加入已有项目账套</view>
          <view class="project-ledger-choice-desc">从 {{projectLedgerProjectCount}} 个项目账套中选择</view>
        </view>
        <view class="project-ledger-choice-arrow">›</view>
      </view>

      <view class="project-ledger-choice {{projectLedgerHasProjects ? '' : 'primary'}}" data-action="create" bindtap="chooseProjectLedgerAction">
        <view class="project-ledger-choice-icon add">＋</view>
        <view class="project-ledger-choice-copy">
          <view class="project-ledger-choice-title">新建账套并加入</view>
          <view class="project-ledger-choice-desc">创建新项目并自动关联本合同</view>
        </view>
        <view class="project-ledger-choice-arrow">›</view>
      </view>

      <button
        class="project-ledger-dismiss"
        data-action="dismiss"
        loading="{{projectLedgerPromptLoading}}"
        disabled="{{projectLedgerPromptLoading}}"
        bindtap="chooseProjectLedgerAction"
      >本合同不再提示</button>
      <view class="project-ledger-prompt-note">稍后也可以在“企业中心 → 项目账套”中操作</view>
    </view>
  </view>

  <!-- 详情面板 -->
  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="panel" catchtap="noop">
      <view class="panel-header"><view class="panel-title">{{detailTitle}}</view><view class="panel-close" bindtap="closeDetail">✕</view></view>
      <view class="timeline" wx:if="{{detailSteps && detailSteps.length > 0}}">
        <view class="tl-item" wx:for="{{detailSteps}}" wx:key="title">
          <view class="tl-dot {{item.done ? 'done' : ''}} {{item.active ? 'active' : ''}}"><view class="tl-dot-inner"></view></view>
          <view class="tl-info"><view class="tl-title {{item.active ? 'active' : ''}}">{{item.title}}</view><view class="tl-time" wx:if="{{item.time}}">{{item.time}}</view></view>
        </view>
      </view>
      <view class="panel-fields">
        <view class="pf-row" wx:for="{{detailFields}}" wx:key="label">
          <view class="pf-label">{{item.label}}</view><view class="pf-value {{item.highlight ? 'hl' : ''}} {{item.amount ? 'amount' : ''}}">{{item.value}}</view>
        </view>
      </view>
      <view class="panel-btn-wrap"><button class="panel-btn" bindtap="closeDetail">关闭</button></view>
    </view>
  </view>
</view>
