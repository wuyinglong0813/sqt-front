<view class="page">
  <!-- 双方信息 -->
  <view class="party-bar">
    <view class="party-item">
      <view class="pi-avatar my">{{myCompanyName[0]}}</view>
      <view class="pi-name">{{myCompanyName}}</view>
      <view class="pi-tag">我方</view>
    </view>
    <view class="party-vs"><image src="/images/logo.png" mode="aspectFit"/></view>
    <view class="party-item">
      <view class="pi-avatar cp">{{counterpartyName[0]}}</view>
      <view class="pi-name">{{counterpartyName}}</view>
      <view class="pi-tag">{{role === 'supplier' ? '客户企业' : '供应商企业'}}</view>
    </view>
  </view>

  <!-- 模板选择 -->
  <view class="card">
    <view class="form-group">
      <view class="form-label">合同模板</view>
      <picker mode="selector" range="{{templates}}" range-key="name" value="{{templateIndex}}" bindchange="onTemplateChange">
        <view class="form-picker">{{templates[templateIndex] ? templates[templateIndex].name : '请选择模板'}} ▾</view>
      </picker>
    </view>
  </view>

  <!-- 合同名称 -->
  <view class="card">
    <view class="form-group">
      <view class="form-label">合同名称</view>
      <input class="form-input" placeholder="请输入合同名称" value="{{contractName}}" bindinput="onContractNameInput"/>
    </view>
  </view>

  <!-- 合同预览 -->
  <block wx:if="{{hasTemplate}}">
    <!-- 合同标题 -->
    <view class="card contract-title-card">
      <view class="ct-title">{{contractName || '请输入合同名称'}}</view>
      <view class="ct-no">合同编号：{{editMode ? (originalContractNo || '原合同编号') : '签订时自动生成'}}</view>
    </view>

    <!-- 头部字段 -->
    <view class="card">
      <view class="section-title">合同信息</view>
      <view class="field-row" wx:for="{{fields}}" wx:key="key">
        <view class="field-label">{{item.label}}</view>

        <block wx:if="{{item.type === 'date'}}">
          <picker mode="date" value="{{item.value}}" data-index="{{index}}" bindchange="onDateFieldChange">
            <view class="field-value date {{item.value ? '' : 'placeholder'}}">{{item.value || '请选择日期'}}</view>
          </picker>
        </block>

        <block wx:elif="{{!item.editable}}">
          <view class="field-value locked">
            <image class="locked-icon" src="/images/icons/role.svg" mode="aspectFit"/>
            <text class="locked-text">{{item.hint || '自动生成'}}</text>
          </view>
        </block>

        <block wx:else>
          <input class="field-input" placeholder="{{item.hint || ''}}" value="{{item.value}}" data-index="{{index}}" bindinput="onFieldChange"/>
        </block>
      </view>
    </view>

    <!-- 产品表格 -->
    <view class="card" wx:if="{{tableSection}}">
      <view class="section-title">{{tableSection.title}}</view>
      <view class="table-scroll-hint">左右滑动可编辑全部列</view>
      <scroll-view class="table-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-left="{{tableScrollLeft}}" bindscroll="onTableScroll" enable-flex>
        <view class="table-wrap">
          <view class="table-row table-header">
            <view class="th" wx:for="{{tableSection.columns}}" wx:for-item="col" wx:key="*this">
              <text>{{col}}</text>
            </view>
            <view class="th th-del"></view>
          </view>
          <view class="table-row" wx:for="{{tableRows}}" wx:for-item="row" wx:for-index="ri" wx:key="ri">
            <view class="td" wx:for="{{tableSection.columns}}" wx:for-item="col" wx:for-index="ci" wx:key="ci">
              <block wx:if="{{ci === amountColumnIndex}}">
                <input class="td-input num auto" type="digit" value="{{row[ci]}}" disabled/>
              </block>
              <block wx:elif="{{ci === quantityColumnIndex || ci === priceColumnIndex}}">
                <input class="td-input num" type="digit" value="{{row[ci]}}" placeholder="0" cursor-spacing="120" adjust-position data-row="{{ri}}" data-col="{{ci}}" bindfocus="onNumberCellFocus" bindblur="onNumberCellBlur" bindinput="onTableCellChange"/>
              </block>
              <block wx:elif="{{ci === productColumnIndex}}">
                <input class="td-input" type="text" value="{{row[ci]}}" data-row="{{ri}}" data-col="{{ci}}" bindinput="onTableCellChange" bindblur="onProductCellBlur"/>
              </block>
              <block wx:else>
                <input class="td-input" type="text" value="{{row[ci]}}" data-row="{{ri}}" data-col="{{ci}}" bindinput="onTableCellChange"/>
              </block>
            </view>
            <view class="td td-del">
              <view class="del-btn" data-index="{{ri}}" bindtap="deleteTableRow">✕</view>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="table-scrollbar" wx:if="{{tableScrollbarVisible}}" bindtouchstart="onTableScrollbarTouchStart" catchtouchmove="onTableScrollbarTouchMove" bindtouchend="onTableScrollbarTouchEnd" bindtouchcancel="onTableScrollbarTouchEnd">
        <view class="table-scrollbar-track">
          <view class="table-scrollbar-thumb" style="width: {{tableScrollbarThumbWidth}}%; left: {{tableScrollbarThumbLeft}}%;">
            <view class="table-scrollbar-grip"></view>
          </view>
        </view>
      </view>
      <view class="inventory-suggestions" wx:if="{{productSuggestions.length > 0}}">
        <view class="suggestion-title">从库存商品中选择品名</view>
        <view class="suggestion-item" wx:for="{{productSuggestions}}" wx:key="productName"
          data-row="{{suggestionRow}}" data-name="{{item.productName}}" bindtap="selectInventoryProduct">
          <text class="suggestion-name">{{item.productName}}</text>
          <text class="suggestion-spec">{{item.specification || '无规格'}}</text>
        </view>
      </view>
      <view class="inventory-suggestions" wx:if="{{specificationSuggestions.length > 0}}">
        <view class="suggestion-title">选择对应规格型号</view>
        <view class="suggestion-item" wx:for="{{specificationSuggestions}}" wx:key="id"
          data-row="{{suggestionRow}}" data-id="{{item.id}}" bindtap="selectInventorySpecification">
          <text class="suggestion-name">{{item.specification || '无规格'}}</text>
          <text class="suggestion-spec">单位：{{item.baseUnit || '件'}}</text>
        </view>
      </view>
      <view class="table-add" bindtap="addTableRow">＋ 添加产品行</view>

      <view class="table-summary">
        <view class="sum-row" wx:if="{{feeItems.length > 0}}">
          <text class="sum-label">商品：</text>
          <text class="sum-secondary">¥{{productTotalAmount}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">合计：</text>
          <text class="sum-amount">¥{{totalAmount}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">大写：</text>
          <text class="sum-chinese">{{totalAmountCn}}</text>
        </view>
      </view>
    </view>

    <view class="card fee-card">
      <view class="section-title fee-section-title">
        <view><text>其他费用</text><view class="fee-section-hint">计入合同金额，但不会进入库存</view></view>
        <text class="fee-add" bindtap="addFeeItem">＋ 添加费用</text>
      </view>
      <view class="fee-empty" wx:if="{{feeItems.length === 0}}">运费、装卸费等请在这里填写，不要作为商品录入</view>
      <view class="fee-item {{activeFeeTypeIndex === index ? 'picker-open' : ''}}" wx:for="{{feeItems}}" wx:key="index">
        <view class="fee-item-head">
          <view><text class="fee-item-index">费用 {{index + 1}}</text><text class="fee-item-kind">{{item.feeType}}</text></view>
          <view class="fee-delete" data-index="{{index}}" bindtap="deleteFeeItem">删除</view>
        </view>
        <view class="fee-form-row fee-type-row" data-index="{{index}}" bindtap="toggleFeeTypeMenu">
          <text class="fee-form-label">费用类型</text>
          <view class="fee-type-picker">
            <text>{{item.feeType}}</text>
            <text class="fee-picker-arrow {{activeFeeTypeIndex === index ? 'open' : ''}}">⌄</text>
          </view>
        </view>
        <view class="fee-type-menu" wx:if="{{activeFeeTypeIndex === index}}">
          <view class="fee-type-option {{item.feeType === option ? 'selected' : ''}}"
            wx:for="{{feeTypeOptions}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="*this"
            data-index="{{index}}" data-type="{{option}}" catchtap="selectFeeType">
            <text>{{option}}</text><text class="fee-type-check" wx:if="{{item.feeType === option}}">✓</text>
          </view>
        </view>
        <view class="fee-form-row">
          <text class="fee-form-label">金额</text>
          <view class="fee-amount-input"><text>¥</text><input type="digit" value="{{item.amount}}" placeholder="0.00" data-index="{{index}}" data-field="amount" bindinput="onFeeFieldInput"/></view>
        </view>
        <view class="fee-form-row fee-remark-wrap">
          <text class="fee-form-label">备注</text>
          <input class="fee-remark" value="{{item.remark}}" maxlength="200" placeholder="例如：送货上门、到付等" data-index="{{index}}" data-field="remark" bindinput="onFeeFieldInput"/>
        </view>
      </view>
      <view class="fee-total" wx:if="{{feeItems.length > 0}}">费用小计：<text>¥{{feeTotalAmount}}</text></view>
    </view>

    <!-- 合同条款可在套用模板后继续修改 -->
    <view class="card">
      <view class="section-title clause-section-title">
        <text>合同条款</text>
        <text class="clause-add" bindtap="addClause">＋ 添加条款</text>
      </view>
      <view class="clause-edit" wx:for="{{clauses}}" wx:for-item="clause" wx:key="index">
        <view class="clause-edit-head">
          <text class="clause-index">{{index + 1}}.</text>
          <input class="clause-title-input" value="{{clause.title}}" placeholder="条款标题"
            data-index="{{index}}" bindinput="onClauseTitleInput"/>
          <text class="clause-delete" data-index="{{index}}" bindtap="deleteClause">删除</text>
        </view>
        <textarea class="clause-content-input" value="{{clause.content}}" placeholder="请输入条款内容"
          auto-height maxlength="-1" cursor-spacing="120" data-index="{{index}}" bindinput="onClauseContentInput"/>
      </view>
      <view class="clause-empty" wx:if="{{clauses.length === 0}}">暂无条款，可点击上方添加</view>
    </view>
  </block>

  <!-- 空态 -->
  <view class="card empty-card" wx:if="{{!hasTemplate && templates.length === 0}}">
    <image class="empty-icon" src="/images/icons/contracts.svg" mode="aspectFit"/>
    <view class="empty-text">暂无可用合同模板</view>
    <view class="empty-sub">请先在合同模板库中创建模板</view>
  </view>

  <!-- 提交 -->
  <view class="submit-area" wx:if="{{hasTemplate}}">
    <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">{{contractActionText}}</button>
  </view>

  <view class="safe-bottom"></view>
</view>
