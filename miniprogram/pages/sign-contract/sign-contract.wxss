page { background: #f4f8fd; }

.page { padding: 24rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

/* 双方信息 */
.party-bar {
  align-items: center;
  background: linear-gradient(160deg, #3498ff, #45a8ff);
  display: flex; justify-content: center;
  padding: 36rpx 40rpx; gap: 32rpx;
  border-radius: 16rpx; margin-bottom: 20rpx;
}
.party-item { align-items: center; display: flex; flex-direction: column; }
.pi-avatar {
  align-items: center; border-radius: 24rpx; color: #fff;
  display: flex; font-size: 40rpx; font-weight: 700;
  height: 88rpx; justify-content: center; width: 88rpx;
}
.pi-avatar.my { background: rgba(255,255,255,0.18); }
.pi-avatar.cp { background: rgba(255,255,255,0.28); }
.pi-name {
  color: #fff; font-size: 26rpx; font-weight: 600; margin-top: 10rpx;
  max-width: 160rpx; overflow: hidden; text-align: center;
  text-overflow: ellipsis; white-space: nowrap;
}
.pi-tag {
  background: rgba(255,255,255,0.22); border-radius: 6rpx;
  color: #fff; font-size: 20rpx; margin-top: 6rpx; padding: 2rpx 16rpx;
}
.party-vs image { border: 2rpx solid rgba(255,255,255,.22); border-radius: 50%; height: 76rpx; width: 76rpx; }

/* CARD */
.card {
  background: #fff; border-radius: 16rpx; margin-bottom: 16rpx;
  padding: 24rpx 28rpx; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.03);
}
.section-title {
  font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx;
  padding-left: 12rpx; border-left: 6rpx solid #3498ff;
}

/* 表单 */
.form-group { margin-bottom: 0; }
.form-label { color: #999; font-size: 24rpx; margin-bottom: 12rpx; }
.form-picker { color: #3498ff; font-size: 30rpx; font-weight: 600; }

/* 合同标题 */
.contract-title-card { text-align: center; padding: 40rpx 28rpx; }
.ct-title { font-size: 40rpx; font-weight: 700; color: #162336; letter-spacing: 8rpx; margin-bottom: 12rpx; }
.ct-no { font-size: 24rpx; color: #999; }

/* 字段 */
.field-row {
  display: flex; align-items: center; padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field-row:last-child { border-bottom: none; }
.field-label { font-size: 26rpx; color: #666; width: 210rpx; flex-shrink: 0; }
.field-input { flex: 1; font-size: 28rpx; color: #222; }
.field-input::placeholder { color: #ccc; }
.field-value { flex: 1; font-size: 28rpx; color: #222; }
.field-value.placeholder { color: #ccc; }
.field-value.date { color: #3498ff; }
.field-value.locked { display: flex; align-items: center; gap: 8rpx; color: #999; }
.locked-icon { height: 36rpx; width: 36rpx; }
.locked-text { font-size: 24rpx; color: #999; }

/* 产品表格 */
.table-scroll-hint { color: #94a2b2; font-size: 21rpx; margin: -6rpx 0 10rpx; text-align: right; }
.table-scroll { width: 100%; }
.table-wrap { min-width: 1030rpx; }
.table-scrollbar { align-items: center; display: flex; height: 34rpx; margin: 7rpx 5rpx 1rpx; position: relative; }
.table-scrollbar-track { background: #e9eef4; border-radius: 7rpx; height: 10rpx; position: relative; width: 100%; }
.table-scrollbar-thumb { align-items: center; background: linear-gradient(90deg,#62b2ff,#3498ff); border-radius: 7rpx; box-shadow: 0 2rpx 7rpx rgba(52,152,255,.28); display: flex; height: 12rpx; justify-content: center; position: absolute; top: -1rpx; transition: left .05s linear; }
.table-scrollbar-grip { background: rgba(255,255,255,.8); border-radius: 2rpx; height: 3rpx; width: 28rpx; }
.table-row { display: flex; align-items: center; }
.table-header { background: #eaf4ff; border-radius: 8rpx 8rpx 0 0; }
.th {
  flex: 1; min-width: 130rpx; padding: 16rpx 6rpx;
  font-size: 24rpx; color: #3498ff; font-weight: 600; text-align: center;
}
.th-del { flex: 0 0 56rpx; min-width: 56rpx; }
.td { flex: 1; min-width: 130rpx; padding: 6rpx 3rpx; }
.td-del { flex: 0 0 56rpx; min-width: 56rpx; display: flex; justify-content: center; align-items: center; }
.td-input {
  width: 100%; height: 56rpx; font-size: 24rpx; color: #333;
  background: #fafafa; border-radius: 6rpx; text-align: center; padding: 0 4rpx; box-sizing: border-box;
}
.td-input.num { text-align: right; }
.td-input.auto { background: #eaf4ff; color: #3498ff; font-weight: 600; }
.del-btn {
  width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #e53e3e; background: #fff5f5; border-radius: 50%;
}
.table-add {
  margin-top: 16rpx; padding: 14rpx; text-align: center;
  font-size: 26rpx; color: #3498ff; background: #eaf4ff; border-radius: 10rpx;
  border: 1rpx dashed #3498ff;
}
.inventory-suggestions {
  margin-top: 12rpx; border: 1rpx solid #d9ebff; border-radius: 10rpx;
  background: #f7fbff; overflow: hidden;
}
.suggestion-title { padding: 12rpx 18rpx; color: #7c8da3; font-size: 22rpx; background: #eef7ff; }
.suggestion-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx; border-top: 1rpx solid #e8f1fa;
}
.suggestion-name { color: #27364a; font-size: 26rpx; font-weight: 600; }
.suggestion-spec { color: #8795a7; font-size: 22rpx; margin-left: 16rpx; }
.table-summary {
  margin-top: 16rpx; padding: 20rpx; background: #fafafa; border-radius: 10rpx;
}
.sum-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.sum-row:last-child { margin-bottom: 0; }
.sum-label { font-size: 26rpx; color: #666; width: 100rpx; flex-shrink: 0; }
.sum-amount { font-size: 30rpx; color: #e53e3e; font-weight: 700; }
.sum-chinese { font-size: 26rpx; color: #3498ff; font-weight: 600; }
.sum-secondary { color: #607286; font-size: 26rpx; font-weight: 600; }

/* 费用项与库存商品分开，避免运费被识别为库存商品。 */
.fee-card { overflow: visible; }
.fee-section-title { align-items: flex-start; display: flex; justify-content: space-between; }
.fee-section-hint { border-left: 0; color: #97a3b0; font-size: 20rpx; font-weight: 400; margin-top: 5rpx; padding-left: 0; }
.fee-add { background: #edf6ff; border-radius: 22rpx; color: #2585df; font-size: 22rpx; font-weight: 600; padding: 8rpx 16rpx; }
.fee-empty { background: #f7f9fc; border-radius: 10rpx; color: #98a4b1; font-size: 23rpx; line-height: 1.6; padding: 22rpx; text-align: center; }
.fee-item { border: 1rpx solid #e1e9f2; border-radius: 14rpx; margin-top: 15rpx; overflow: hidden; position: relative; }
.fee-item-head { align-items: center; background: #f6f9fc; border-bottom: 1rpx solid #e8eef5; display: flex; justify-content: space-between; min-height: 58rpx; padding: 0 17rpx; }
.fee-item-head > view:first-child { align-items: center; display: flex; }
.fee-item-index { color: #31465d; font-size: 22rpx; font-weight: 650; }
.fee-item-kind { background: #e9f4ff; border-radius: 13rpx; color: #368cdd; font-size: 18rpx; margin-left: 10rpx; padding: 4rpx 10rpx; }
.fee-delete { color: #d4666d; font-size: 20rpx; padding: 10rpx 0 10rpx 18rpx; }
.fee-form-row { align-items: center; background: #fff; border-bottom: 1rpx solid #edf1f5; display: flex; min-height: 72rpx; padding: 0 17rpx; }
.fee-form-row:last-child { border-bottom: 0; }
.fee-form-label { color: #718195; flex-shrink: 0; font-size: 22rpx; width: 130rpx; }
.fee-type-picker { align-items: center; color: #253a52; display: flex; flex: 1; font-size: 23rpx; font-weight: 600; justify-content: space-between; }
.fee-picker-arrow { color: #8ca0b4; font-size: 29rpx; line-height: 1; transform: rotate(0deg); transition: transform .18s ease; }
.fee-picker-arrow.open { transform: rotate(180deg); }
.fee-type-menu { background: #f5f9fd; border-bottom: 1rpx solid #e5edf5; display: grid; gap: 10rpx; grid-template-columns: repeat(3,minmax(0,1fr)); padding: 14rpx 17rpx; }
.fee-type-option { align-items: center; background: #fff; border: 1rpx solid #dfe8f1; border-radius: 9rpx; color: #5d6f82; display: flex; font-size: 20rpx; justify-content: center; min-height: 52rpx; position: relative; }
.fee-type-option.selected { background: #e8f4ff; border-color: #73b7f5; color: #2585df; font-weight: 650; }
.fee-type-check { font-size: 17rpx; margin-left: 6rpx; }
.fee-amount-input { align-items: center; display: flex; flex: 1; }
.fee-amount-input > text { color: #e06c3b; font-size: 24rpx; font-weight: 650; margin-right: 7rpx; }
.fee-amount-input input { color: #d95e31; flex: 1; font-size: 24rpx; font-weight: 650; min-width: 0; }
.fee-remark { color: #40546a; flex: 1; font-size: 22rpx; min-width: 0; }
.fee-total { color: #6f7d8d; font-size: 24rpx; margin-top: 16rpx; text-align: right; }
.fee-total text { color: #e06139; font-size: 28rpx; font-weight: 700; }

/* 可编辑合同条款 */
.clause-section-title { display: flex; justify-content: space-between; align-items: center; }
.clause-add { color: #3498ff; font-size: 24rpx; font-weight: 400; }
.clause-edit { margin-bottom: 20rpx; padding: 18rpx; border-radius: 10rpx; background: #f8fafc; }
.clause-edit-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.clause-index { color: #3498ff; font-size: 25rpx; margin-right: 8rpx; }
.clause-title-input { flex: 1; color: #26364a; font-size: 26rpx; font-weight: 600; }
.clause-delete { color: #e25a5a; font-size: 22rpx; margin-left: 14rpx; }
.clause-content-input {
  width: 100%; min-height: 112rpx; box-sizing: border-box; padding: 14rpx;
  color: #526175; font-size: 25rpx; line-height: 1.7; border-radius: 8rpx; background: #fff;
}
.clause-empty { text-align: center; color: #a5afbd; font-size: 24rpx; padding: 28rpx 0; }

/* 空态 */
.empty-card { text-align: center; padding: 80rpx 28rpx; }
.empty-icon { height: 108rpx; margin-bottom: 16rpx; width: 108rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 8rpx; }
.empty-sub { font-size: 24rpx; color: #ccc; }

/* 提交 */
.submit-area {
  background: #fff; bottom: 0; left: 0; right: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  position: fixed; box-sizing: border-box; z-index: 10;
}
.submit-btn {
  background: linear-gradient(90deg, #3498ff, #45a8ff); border: none;
  border-radius: 48rpx; color: #fff; font-size: 32rpx; font-weight: 600;
  height: 96rpx; line-height: 96rpx; width: 100%;
}
.submit-btn::after { border: none; }
.safe-bottom { height: 60rpx; }
