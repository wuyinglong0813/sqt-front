<view class="retail-page">
  <view class="retail-error" wx:if="{{error}}">{{error}}</view><view class="retail-loading" wx:if="{{loading}}">加载中…</view>
  <block wx:if="{{detail}}">
    <view class="retail-card">
      <view class="retail-head"><view class="retail-badge {{detail.status}}">{{detail.statusText}}</view><view class="retail-badge {{detail.isReturn ? 'return' : ''}}">{{terms.business}}{{detail.isReturn ? '退货' : ''}}</view></view>
      <view class="retail-title" style="margin-top:24rpx">{{detail.documentNo}}</view>
      <view class="retail-sub" wx:if="{{terms.isPurchase !== detail.isReturn}}">{{detail.customer.name}} → {{detail.companyName}}</view>
      <view class="retail-sub" wx:else>{{detail.companyName}} → {{detail.customer.name}}</view>
      <view class="retail-total"><view>{{detail.isReturn ? '退货' : terms.order}}金额</view><view class="retail-total-value">{{detail.isReturn ? '−' : ''}}¥{{detail.amountText}}</view></view>
      <view class="retail-info"><view class="retail-info-label">单据日期</view><view>{{detail.orderDate}}</view></view>
      <view class="retail-info"><view class="retail-info-label">制单人</view><view>{{detail.preparedByName}}</view></view>
      <view class="retail-info" wx:if="{{detail.originalDocumentNo}}"><view class="retail-info-label">原{{terms.order}}</view><view class="retail-info-value">{{detail.originalDocumentNo}}</view></view>
      <view class="retail-info"><view class="retail-info-label">{{terms.isPurchase !== detail.isReturn ? '入库' : '出库'}}状态</view><view>{{detail.stockProcessed ? '已完成' : '待处理'}}</view></view>
    </view>
    <view class="retail-card"><view class="retail-title">{{terms.party}}信息</view><view class="retail-info"><view class="retail-info-label">联系人</view><view>{{detail.customer.contact || '—'}}</view></view><view class="retail-info"><view class="retail-info-label">电话</view><view>{{detail.customer.phone || '—'}}</view></view><view class="retail-info" wx:if="{{detail.customer.address}}"><view class="retail-info-label">{{terms.address}}</view><view class="retail-info-value">{{detail.customer.address}}</view></view></view>
    <view class="retail-card"><view class="retail-title">商品及费用明细</view><view class="retail-orderrow" wx:for="{{detail.items}}" wx:key="id"><view class="retail-name">{{item.productName}} <text class="retail-badge" wx:if="{{item.lineType === 'FEE'}}">费用</text></view><view class="retail-sub" wx:if="{{item.model}}">型号：{{item.model}}</view><view class="retail-sub">{{item.specification}} · {{item.quantity}} {{item.baseUnit}} × ¥{{item.unitPrice}}</view><view class="retail-sub" wx:if="{{item.hasRoundingAdjustment}}">含累计舍入尾差</view><view class="retail-info"><view class="retail-info-label">{{item.remark}}</view><view class="retail-orderamount">¥{{item.amountText}}</view></view></view><view class="retail-sub" wx:if="{{detail.remark}}">{{detail.isReturn ? '退货原因' : '备注'}}：{{detail.remark}}</view></view>
    <view class="retail-note" wx:if="{{detail.status === 'DRAFT'}}">草稿尚未生效，确认后计入{{terms.action}}金额及{{terms.party}}往来。</view>
    <view class="retail-note" wx:elif="{{detail.isReturn}}">退货已生效，已冲减{{terms.party}}往来及净{{terms.action}}额。退款另行记录。</view>
    <view class="retail-note" wx:else>{{terms.order}}已生效，已计入{{terms.action}}金额及{{terms.party}}往来。</view>
    <view class="retail-actions" wx:if="{{detail.canEdit}}"><button class="retail-secondary" disabled="{{working}}" bindtap="edit">编辑草稿</button><button class="retail-primary" disabled="{{working}}" loading="{{working}}" bindtap="confirm">{{detail.isReturn ? '确认退货' : '确认开单'}}</button></view>
    <view class="retail-actions"><button class="retail-secondary" disabled="{{downloading}}" loading="{{downloading}}" bindtap="viewPdf">查看 PDF</button><button class="retail-secondary" disabled="{{downloading}}" data-share="1" bindtap="viewPdf">导出 PDF</button></view>
    <button class="retail-primary" style="margin-top:24rpx" wx:if="{{detail.canProcessStock}}" disabled="{{working}}" loading="{{working}}" bindtap="processStock">办理{{detail.isReturn ? '退货' : terms.action}}{{terms.isPurchase !== detail.isReturn ? '入库' : '出库'}}</button>
    <view class="retail-actions" wx:if="{{detail.status === 'CONFIRMED'}}"><button class="retail-secondary" bindtap="openCustomer">查看{{terms.party}}往来</button><button class="retail-primary" wx:if="{{detail.canCreateReturn}}" bindtap="createReturn">开{{terms.returnOrder}}</button></view>
    <button class="retail-danger" style="margin-top:24rpx" wx:if="{{detail.canEdit}}" disabled="{{working}}" bindtap="deleteDraft">删除草稿</button>
  </block>
</view>
