page { background: #f4f8fd; }
.page { min-height: 100vh; padding-bottom: calc(34rpx + env(safe-area-inset-bottom)); }
.hero {
  background: linear-gradient(138deg,#45a8ff 0%,#3498ff 48%,#2478df 100%);
  color: #fff;
  padding: 34rpx 28rpx 30rpx;
}
.hero-title { font-size: 35rpx; font-weight: 700; }
.hero-desc { color: rgba(255,255,255,.78); font-size: 22rpx; margin-top: 8rpx; }
.upload-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 28rpx; }
.upload-btn {
  border-radius: 20rpx; font-size: 25rpx; font-weight: 600; height: 78rpx;
  line-height: 78rpx; margin: 0; padding: 0;
}
.upload-btn::after { border: 0; }
.upload-btn.primary { background: #fff; color: #2382e9; }
.upload-btn.secondary { background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.38); color: #fff; }
.type-tabs {
  background: #fff; border-bottom: 1rpx solid #e5edf6; display: grid;
  grid-template-columns: 1fr 1fr 1fr; padding: 0 16rpx;
}
.type-tab { color: #7e8b9b; font-size: 26rpx; padding: 25rpx 0 21rpx; position: relative; text-align: center; }
.type-tab.active { color: #3498ff; font-weight: 700; }
.type-tab.active::after {
  background: #3498ff; border-radius: 3rpx; bottom: 0; content: ''; height: 6rpx;
  left: 50%; position: absolute; transform: translateX(-50%); width: 54rpx;
}
.tab-count { background: #eef5fd; border-radius: 15rpx; font-size: 18rpx; margin-left: 6rpx; padding: 2rpx 8rpx; }
.tab-arrow { color: #9aacbf; font-size: 25rpx; }
.format-tip {
  align-items: flex-start; background: #eaf4ff; border: 1rpx solid #d5e9ff; border-radius: 18rpx;
  color: #5c7490; display: flex; font-size: 21rpx; line-height: 1.55; margin: 20rpx 24rpx; padding: 17rpx 18rpx;
}
.tip-dot { background: #3498ff; border-radius: 50%; flex-shrink: 0; height: 10rpx; margin: 11rpx 12rpx 0 0; width: 10rpx; }
.template-list { padding: 0 24rpx; }
.template-card {
  align-items: center; background: #fff; border: 1rpx solid #e0eaf5; border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(27,67,112,.055); display: flex; margin-bottom: 16rpx; padding: 22rpx;
}
.template-icon {
  align-items: center; background: linear-gradient(145deg,#e8f4ff,#d9ecff); border-radius: 18rpx;
  color: #3498ff; display: flex; flex-shrink: 0; font-size: 26rpx; font-weight: 700;
  height: 68rpx; justify-content: center; width: 68rpx;
}
.template-copy { flex: 1; margin-left: 16rpx; min-width: 0; }
.template-name { color: #1c2b3d; font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.template-meta { color: #93a0af; font-size: 20rpx; margin-top: 7rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.template-tag { background: #eaf4ff; border-radius: 15rpx; color: #3498ff; font-size: 19rpx; padding: 5rpx 10rpx; }
.template-delete { color: #b2bdc9; font-size: 21rpx; margin-left: 12rpx; padding: 14rpx 0 14rpx 12rpx; }
.template-view { color: #2382e9; flex-shrink: 0; font-size: 22rpx; margin-left: 12rpx; }
.template-card-pressed { background: #f6faff; }
.loading { color: #8e9aaa; font-size: 25rpx; padding: 100rpx 0; text-align: center; }
.empty { align-items: center; display: flex; flex-direction: column; padding: 86rpx 24rpx 50rpx; }
.empty image { height: 110rpx; opacity: .72; width: 110rpx; }
.empty-title { color: #445469; font-size: 28rpx; font-weight: 600; margin-top: 18rpx; }
.empty-desc { color: #7e8b9b; font-size: 22rpx; line-height: 1.6; margin-top: 8rpx; text-align: center; }
.restore-btn { background: #3498ff; border-radius: 18rpx; color: #fff; font-size: 26rpx; margin: 28rpx 0 0; padding: 0 28rpx; }
.restore-btn::after { border: 0; }
.empty-note { color: #9aa6b4; font-size: 21rpx; margin-top: 16rpx; }
.standard-link { color: #2382e9; font-size: 24rpx; padding: 12rpx 24rpx; text-align: center; }
.page-end { color: #9aa6b4; font-size: 20rpx; padding: 30rpx 0; text-align: center; }
.template-layer { inset: 0; position: fixed; z-index: 40; }
.layer-mask { background: rgba(19,36,57,.46); inset: 0; position: absolute; }
.template-panel { background: #f5f8fc; border-radius: 30rpx 30rpx 0 0; bottom: 0; display: flex; flex-direction: column; left: 0; max-height: 90vh; position: absolute; right: 0; }
.panel-heading { align-items: center; background: #fff; border-radius: 30rpx 30rpx 0 0; color: #24374d; display: flex; flex-shrink: 0; font-size: 31rpx; font-weight: 700; justify-content: space-between; padding: 25rpx 28rpx 18rpx; }
.panel-close { color: #8f9dab; font-size: 45rpx; font-weight: 400; line-height: 1; padding: 3rpx 0 3rpx 24rpx; }
.panel-intro { color: #7f8da0; font-size: 23rpx; padding: 0 28rpx 20rpx; }
.options-panel { background: #fff; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.template-option { border: 1rpx solid #e0e9f2; border-radius: 20rpx; margin: 0 26rpx 18rpx; padding: 24rpx; }
.template-option.recommended { background: #f1f8ff; border-color: #bedfff; }
.option-heading { align-items: center; color: #24374d; display: flex; font-size: 28rpx; font-weight: 600; }
.recommended-tag { background: #e0efff; border-radius: 8rpx; color: #2382e9; font-size: 19rpx; margin-left: 12rpx; padding: 4rpx 10rpx; }
.option-arrow { color: #9aabba; font-size: 35rpx; font-weight: 400; margin-left: auto; }
.option-desc { color: #7a8b9d; font-size: 23rpx; line-height: 1.65; margin-top: 10rpx; }
.option-action { color: #2382e9; font-size: 24rpx; font-weight: 500; line-height: 1.5; margin-top: 16rpx; }
.panel-scroll { flex: 1; height: 60vh; min-height: 0; }
.guide-section { background: #fff; border-radius: 18rpx; margin: 18rpx 24rpx; padding: 24rpx; }
.guide-title { color: #304258; font-size: 26rpx; font-weight: 600; }
.guide-copy { color: #7a8899; font-size: 23rpx; line-height: 1.7; margin-top: 10rpx; overflow-wrap: break-word; white-space: pre-line; word-break: break-all; }
.guide-note { background: #fff7ea; border-radius: 12rpx; color: #a7773e; font-size: 22rpx; line-height: 1.6; margin-top: 16rpx; padding: 16rpx; }
.json-example { background: #f1f5f9; border-radius: 12rpx; color: #58708a; display: block; font-family: monospace; font-size: 22rpx; line-height: 1.6; margin-top: 18rpx; overflow-wrap: break-word; padding: 18rpx; white-space: pre-wrap; word-break: break-all; }
.example-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.example-copy { background: #edf5ff; border-radius: 12rpx; color: #2382e9; font-size: 23rpx; line-height: 2.5; margin: 0; padding: 0 20rpx; }
.example-copy::after, .panel-primary::after { border: 0; }
.panel-footer { background: #fff; border-top: 1rpx solid #e6edf5; flex-shrink: 0; padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom)); }
.panel-primary { background: #3498ff; border-radius: 18rpx; color: #fff; font-size: 26rpx; line-height: 1.5; margin: 0; padding: 23rpx 18rpx; }
.preview-summary { background: #fff; margin-bottom: 18rpx; padding: 24rpx 28rpx; }
.preview-name { color: #304258; font-size: 28rpx; font-weight: 600; overflow-wrap: break-word; }
.preview-name-input { background: #f2f7fd; border: 1rpx solid #dbe8f6; border-radius: 12rpx; box-sizing: border-box; color: #304258; font-size: 26rpx; height: 76rpx; margin-top: 14rpx; padding: 0 18rpx; width: 100%; }
.preview-notice { color: #8d9aab; font-size: 21rpx; line-height: 1.6; margin: 0 26rpx 16rpx; }
.document-sample { background: #fff; border: 1rpx solid #e1e9f2; border-radius: 16rpx; margin: 0 24rpx; overflow: hidden; padding: 24rpx 20rpx; }
.sample-company { color: #405269; font-size: 25rpx; text-align: center; }
.sample-title { color: #24374d; font-size: 34rpx; font-weight: 700; margin: 8rpx 0 24rpx; text-align: center; }
.sample-info { color: #8591a0; font-size: 21rpx; line-height: 1.8; }
.table-scroll-hint { color: #2382e9; font-size: 20rpx; margin: 15rpx 0 10rpx; }
.sample-table-scroll { width: 100%; }
.sample-table { border-left: 1rpx solid #dbe4ee; border-top: 1rpx solid #dbe4ee; }
.sample-table-row { display: flex; }
.sample-cell { align-items: center; border-bottom: 1rpx solid #dbe4ee; border-right: 1rpx solid #dbe4ee; box-sizing: border-box; color: #728398; display: flex; flex: 1; font-size: 20rpx; justify-content: center; line-height: 1.4; min-height: 48rpx; min-width: 0; padding: 8rpx 6rpx; text-align: center; word-break: break-all; }
.sample-table-head { background: #eef5fc; }
.sample-table-head .sample-cell { color: #405b77; font-weight: 600; }
.sample-total { color: #556c84; font-size: 22rpx; margin-top: 18rpx; text-align: right; }
.sample-signatures { color: #8591a0; display: flex; font-size: 21rpx; justify-content: space-between; margin-top: 36rpx; }
.preview-help { color: #7a8b9e; font-size: 22rpx; line-height: 1.7; margin: 20rpx 28rpx 26rpx; }
