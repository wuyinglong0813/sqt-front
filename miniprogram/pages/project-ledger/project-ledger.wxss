page { background: #f4f8fd; }
.page { min-height: 100vh; padding-bottom: calc(38rpx + env(safe-area-inset-bottom)); }
.hero { background: linear-gradient(138deg,#45a8ff,#2478df); color: #fff; padding: 34rpx 30rpx 36rpx; }
.hero-label { color: rgba(255,255,255,.68); font-size: 21rpx; }
.hero-title { font-size: 38rpx; font-weight: 700; margin-top: 7rpx; }
.hero-sub { color: rgba(255,255,255,.78); font-size: 22rpx; line-height: 1.6; margin-top: 7rpx; }
.hero-count { background: rgba(255,255,255,.15); border-radius: 14rpx; margin-top: 24rpx; padding: 17rpx 20rpx; width: 190rpx; }
.hero-count text { font-size: 34rpx; font-weight: 700; }.hero-count label { color: rgba(255,255,255,.72); font-size: 21rpx; margin-left: 10rpx; }
.pending-contract-tip { align-items: center; background: #fff; border: 1rpx solid #cfe3f7; border-radius: 17rpx; display: flex; margin: 20rpx 24rpx 0; padding: 18rpx; }
.pending-contract-icon { align-items: center; background: #e9f5ff; border-radius: 12rpx; color: #2887df; display: flex; flex: 0 0 54rpx; font-size: 24rpx; font-weight: 700; height: 54rpx; justify-content: center; margin-right: 14rpx; }
.pending-contract-copy { color: #29415a; font-size: 24rpx; font-weight: 700; min-width: 0; }
.pending-contract-copy text { color: #7f8f9f; display: block; font-size: 20rpx; font-weight: 400; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.section-head { align-items: center; display: flex; justify-content: space-between; padding: 26rpx 24rpx 15rpx; }
.section-title { color: #203248; font-size: 29rpx; font-weight: 700; }.section-sub { color: #94a0ad; font-size: 20rpx; margin-top: 4rpx; }
.section-head button,.contract-head button { background: #eaf4ff; border: 0; border-radius: 13rpx; color: #2787e3; font-size: 22rpx; height: 62rpx; line-height: 62rpx; margin: 0; padding: 0 16rpx; }
button::after { border: 0; }
.project-list { padding: 0 24rpx; }.project-card { background: #fff; border: 1rpx solid #dfe8f3; border-radius: 19rpx; margin-bottom: 14rpx; padding: 22rpx; }
.project-top,.contract-row,.detail-head,.contract-head { align-items: center; display: flex; justify-content: space-between; }
.project-main { min-width: 0; }.project-name { color: #22374e; font-size: 28rpx; font-weight: 700; }.project-no { color: #9aa5b2; font-size: 19rpx; margin-top: 5rpx; }
.contract-count { color: #4389ce; font-size: 21rpx; flex-shrink: 0; margin-left: 12rpx; }.project-description { color: #7e8a98; font-size: 21rpx; margin-top: 13rpx; }
.amount-grid,.summary-grid { display: grid; gap: 8rpx; grid-template-columns: repeat(3,1fr); margin-top: 19rpx; }.amount-grid view { background: #f6f9fd; border-radius: 11rpx; padding: 14rpx 10rpx; }
.amount-grid label,.summary-grid label { color: #98a3af; display: block; font-size: 18rpx; }.amount-grid text { color: #2a82d8; display: block; font-size: 23rpx; font-weight: 700; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; }
.negative { color: #e35d62 !important; }.empty { align-items: center; color: #8290a0; display: flex; flex-direction: column; padding: 70rpx 24rpx; text-align: center; }.empty image { height: 86rpx; opacity: .62; width: 86rpx; }.empty view { font-size: 27rpx; margin-top: 13rpx; }.empty text { color: #a0aab5; font-size: 21rpx; margin-top: 7rpx; }.empty button { background: #3498ff; border: 0; border-radius: 13rpx; color: #fff; font-size: 23rpx; margin-top: 24rpx; }.loading,.empty-inline { color: #97a3af; font-size: 22rpx; padding: 45rpx 20rpx; text-align: center; }
.mask,.detail-mask,.assign-mask { align-items: flex-end; background: rgba(10,24,42,.5); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 300; }.assign-mask { z-index: 420; }
.form-sheet,.detail-sheet,.assign-sheet { background: #fff; border-radius: 28rpx 28rpx 0 0; box-sizing: border-box; padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); width: 100%; }.detail-sheet { height: 88vh; padding-top: 15rpx; }.assign-sheet { display: flex; flex-direction: column; height: 82vh; max-height: calc(100vh - 70rpx); min-height: 0; overflow: hidden; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.sheet-grabber { background: #d8e0e9; border-radius: 4rpx; height: 7rpx; margin: 0 auto 22rpx; width: 70rpx; }.detail-title,.sheet-title { color: #1c2f45; font-size: 32rpx; font-weight: 700; }.detail-no { color: #98a4b1; font-size: 20rpx; margin-top: 5rpx; }.close { align-items: center; color: #8290a0; display: flex; font-size: 40rpx; height: 58rpx; justify-content: center; width: 58rpx; }
.summary-grid { background: #f2f7fd; border-radius: 16rpx; padding: 18rpx; }.summary-grid text { color: #287fd3; display: block; font-size: 25rpx; font-weight: 700; margin-top: 6rpx; }.contract-head { margin-top: 25rpx; }.contract-title { color: #273a50; font-size: 27rpx; font-weight: 700; }.contract-sub { color: #9aa5b1; font-size: 19rpx; margin-top: 4rpx; }.contract-list { height: calc(88vh - 310rpx); margin-top: 15rpx; }.contract-card { border: 1rpx solid #e0e8f2; border-radius: 15rpx; margin-bottom: 12rpx; padding: 18rpx; position: relative; }.direction { background: #edf7ff; border-radius: 8rpx; color: #2385df; font-size: 19rpx; padding: 5rpx 10rpx; }.direction.purchase { background: #fff4e8; color: #d78124; }.contract-amount { color: #273d55; font-size: 25rpx; font-weight: 700; }.contract-name { color: #25384f; font-size: 24rpx; font-weight: 700; margin-top: 12rpx; padding-right: 110rpx; }.contract-meta { color: #98a3af; font-size: 19rpx; margin-top: 5rpx; }.inactive-tip { color: #dc7a2f; font-size: 19rpx; margin-top: 7rpx; }.remove { bottom: 15rpx; color: #e25d65; font-size: 20rpx; padding: 12rpx; position: absolute; right: 8rpx; }
.field-label { color: #7f8c9b; font-size: 22rpx; margin: 18rpx 0 8rpx; }.form-sheet input,.form-sheet textarea { background: #f5f8fc; border: 1rpx solid #e0e8f2; border-radius: 12rpx; box-sizing: border-box; font-size: 25rpx; padding: 0 18rpx; width: 100%; }.form-sheet input { height: 76rpx; }.form-sheet textarea { height: 130rpx; padding-top: 16rpx; }.form-sheet button,.assign-button { background: #3498ff; border: 0; border-radius: 14rpx; color: #fff; font-size: 25rpx; height: 74rpx; line-height: 74rpx; margin: 25rpx 0 0; width: 100%; }
.assign-rule { align-items: flex-start; background: #f2f7fc; border-radius: 13rpx; color: #71869b; display: flex; flex-shrink: 0; font-size: 19rpx; line-height: 1.5; margin-top: 18rpx; padding: 13rpx 15rpx; }
.assign-rule-icon { align-items: center; background: #5a9bd8; border-radius: 50%; color: #fff; display: flex; flex: 0 0 28rpx; font-size: 17rpx; font-weight: 700; height: 28rpx; justify-content: center; margin: 1rpx 10rpx 0 0; }
.select-list { flex: 1; height: 0; margin: 16rpx 0; min-height: 0; }.select-card { align-items: center; border: 1rpx solid #dfe8f2; border-radius: 15rpx; display: flex; margin-bottom: 12rpx; padding: 17rpx; }.select-card.selected { background: #f1f8ff; border-color: #55a3ec; }.check { align-items: center; border: 2rpx solid #bdc9d6; border-radius: 8rpx; color: #fff; display: flex; flex: 0 0 38rpx; font-size: 23rpx; height: 38rpx; justify-content: center; margin-right: 14rpx; }.selected .check { background: #3498ff; border-color: #3498ff; }.select-main { flex: 1; min-width: 0; }.select-name { color: #263a51; font-size: 23rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.select-meta { color: #98a3af; font-size: 18rpx; margin-top: 4rpx; }.select-amount { color: #2e7fc9; flex-shrink: 0; font-size: 22rpx; font-weight: 700; margin-left: 12rpx; }
.assign-footer { align-items: center; border-top: 1rpx solid #e8edf3; display: flex; flex-shrink: 0; gap: 18rpx; padding-top: 18rpx; }
.assign-selected { color: #8795a4; flex: 1; font-size: 20rpx; white-space: nowrap; }.assign-selected text { color: #2e88dd; font-size: 26rpx; font-weight: 700; margin: 0 3rpx; }
.assign-footer .assign-button { flex: 0 0 330rpx; margin: 0; width: 330rpx; }.assign-button[disabled] { background: #abcdec; color: #edf5fc; }

/* 新建项目 */
.create-sheet {
  background: #f6f9fd;
  border-radius: 34rpx 34rpx 0 0;
  overflow: hidden;
  padding: 0 0 calc(24rpx + env(safe-area-inset-bottom));
}
.create-head {
  background: linear-gradient(135deg, #287fda 0%, #41a3f5 100%);
  box-sizing: border-box;
  color: #fff;
  padding: 30rpx 32rpx 28rpx;
  position: relative;
}
.create-head::after {
  background: rgba(255,255,255,.1);
  border-radius: 50%;
  content: '';
  height: 190rpx;
  position: absolute;
  right: -46rpx;
  top: -75rpx;
  width: 190rpx;
}
.create-head-main {
  align-items: center;
  display: flex;
  position: relative;
  z-index: 1;
}
.create-icon {
  align-items: center;
  background: rgba(255,255,255,.18);
  border: 1rpx solid rgba(255,255,255,.28);
  border-radius: 17rpx;
  display: flex;
  height: 68rpx;
  justify-content: center;
  margin-right: 18rpx;
  width: 68rpx;
}
.create-icon image { filter: brightness(0) invert(1); height: 38rpx; width: 38rpx; }
.create-eyebrow { color: rgba(255,255,255,.66); font-size: 17rpx; font-weight: 600; letter-spacing: 2rpx; }
.create-title { font-size: 32rpx; font-weight: 700; margin-top: 3rpx; }
.create-subtitle { color: rgba(255,255,255,.77); font-size: 21rpx; line-height: 1.55; margin-top: 19rpx; padding-right: 70rpx; position: relative; z-index: 1; }
.create-close {
  align-items: center;
  background: rgba(255,255,255,.14);
  border-radius: 50%;
  display: flex;
  font-size: 35rpx;
  height: 52rpx;
  justify-content: center;
  position: absolute;
  right: 28rpx;
  top: 30rpx;
  width: 52rpx;
  z-index: 2;
}
.create-form {
  background: #fff;
  border: 1rpx solid #e4ebf3;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 26rpx rgba(41,72,105,.06);
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
}
.form-group { margin-top: 25rpx; }
.form-group:first-child { margin-top: 0; }
.form-label-row { align-items: center; display: flex; justify-content: space-between; margin-bottom: 11rpx; }
.form-label { color: #31445a; font-size: 23rpx; font-weight: 650; }
.form-label text { color: #ef5b62; margin-left: 3rpx; }
.form-count { color: #a3adba; font-size: 18rpx; }
.optional-tag { background: #f0f4f8; border-radius: 8rpx; color: #8d99a7; font-size: 17rpx; padding: 4rpx 10rpx; }
.input-shell {
  align-items: center;
  background: #f7f9fc;
  border: 1rpx solid #dfe7f0;
  border-radius: 15rpx;
  display: flex;
  height: 82rpx;
  padding: 0 17rpx;
}
.primary-group .input-shell { background: #f5faff; border-color: #a9d2f6; box-shadow: 0 0 0 5rpx rgba(52,152,255,.05); }
.input-mark {
  align-items: center;
  background: #3498ff;
  border-radius: 10rpx;
  color: #fff;
  display: flex;
  flex: 0 0 46rpx;
  font-size: 19rpx;
  font-weight: 700;
  height: 46rpx;
  justify-content: center;
  margin-right: 14rpx;
}
.input-mark.secondary { background: #e8f1fa; color: #5a83ab; font-size: 24rpx; }
.create-sheet .input-shell input {
  background: transparent;
  border: 0;
  color: #263b52;
  flex: 1;
  font-size: 25rpx;
  height: 80rpx;
  min-width: 0;
  padding: 0;
}
.form-hint { color: #a0aab6; font-size: 18rpx; line-height: 1.45; margin: 8rpx 2rpx 0; }
.textarea-shell {
  background: #f7f9fc;
  border: 1rpx solid #dfe7f0;
  border-radius: 15rpx;
  box-sizing: border-box;
  height: 144rpx;
  padding: 15rpx 17rpx 35rpx;
  position: relative;
}
.create-sheet .textarea-shell textarea {
  background: transparent;
  border: 0;
  box-sizing: border-box;
  color: #31455b;
  font-size: 23rpx;
  height: 88rpx;
  padding: 0;
  width: 100%;
}
.textarea-count { bottom: 10rpx; color: #a5aebb; font-size: 17rpx; position: absolute; right: 14rpx; }
.create-tip {
  align-items: flex-start;
  background: #edf7ff;
  border-radius: 13rpx;
  color: #6c849b;
  display: flex;
  font-size: 19rpx;
  line-height: 1.55;
  margin-top: 24rpx;
  padding: 14rpx 16rpx;
}
.tip-dot {
  align-items: center;
  background: #49a0ed;
  border-radius: 50%;
  color: #fff;
  display: flex;
  flex: 0 0 30rpx;
  font-size: 17rpx;
  height: 30rpx;
  justify-content: center;
  margin: 1rpx 10rpx 0 0;
}
.create-actions { display: grid; gap: 16rpx; grid-template-columns: 1fr 2fr; padding: 22rpx 24rpx 0; }
.create-sheet .create-actions button {
  border-radius: 15rpx;
  font-size: 25rpx;
  font-weight: 600;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  padding: 0;
  width: 100%;
}
.create-sheet .create-cancel { background: #e9eef4; color: #617386; }
.create-sheet .create-submit { background: linear-gradient(110deg,#3498ff,#2582e0); box-shadow: 0 8rpx 18rpx rgba(45,137,226,.22); color: #fff; }
.create-sheet .create-submit[disabled] { background: #b7cce0; box-shadow: none; color: #edf3f8; }
