page { background:#f4f8fd; }
.purchase-page { padding:28rpx 24rpx calc(50rpx + env(safe-area-inset-bottom)); color:#1b2a3c; }
.company-name { font-size:32rpx; font-weight:600; word-break:break-all; }
.panel { background:#fff; border:1rpx solid #dfeaf6; border-radius:24rpx; padding:28rpx; margin-top:24rpx; }
.product-name { font-size:30rpx; font-weight:600; }
.price { color:#2478df; font-size:44rpx; font-weight:600; margin:18rpx 0; }
.offer { color:#2478df; font-size:21rpx; font-weight:400; margin-left:16rpx; }
.rights { font-size:26rpx; }
.note { font-size:22rpx; line-height:1.7; color:#728198; margin-top:12rpx; }
.notice { font-size:25rpx; line-height:1.6; padding:24rpx; background:#eaf3ff; border-radius:18rpx; margin-top:24rpx; }
.primary-button { color:#fff; background:#3498ff; border-radius:18rpx; font-size:25rpx; margin-top:24rpx; }
.primary-button[disabled] { color:#728198; background:#edf2f7; }
.primary-button::after { border:0; }
.message { padding:28rpx 6rpx; color:#728198; font-size:25rpx; }
.link { margin:30rpx 6rpx; color:#2478df; font-size:25rpx; }
