<view class="return-page">
  <view class="return-icon {{failed ? 'failed' : ''}}">{{loading ? '…' : (failed ? '!' : '✓')}}</view>
  <view class="return-title">{{title}}</view>
  <view class="return-message">{{message}}</view>
  <button wx:if="{{failed && !reviewRequired}}" class="return-button" bindtap="retrySync">{{supplementaryOrganization ? '重新核验授权状态' : '重新同步'}}</button>
  <view class="return-message" wx:if="{{!loading && !failed && !continuingBusiness && options.scene !== 'personal' && options.scene !== 'company'}}">{{countdown}} 秒后返回业务页面</view>
  <view class="return-link" bindtap="goBusinessPage" wx:if="{{!loading}}">{{reviewRequired ? '返回法人身份记录页联系平台支持' : (continuingBusiness ? (failed ? (options.scene === 'personal' ? '返回个人认证' : '返回原业务') : '继续原业务') : (failed ? (options.scene === 'company' && !supplementaryOrganization ? '返回企业认证' : '返回业务页面') : (options.scene === 'company' ? '立即进入企业中心' : (options.scene === 'personal' && options.flow !== 'company-create' ? '立即进入首页' : '立即继续'))))}}</view>
</view>
