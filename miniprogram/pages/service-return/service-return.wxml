<view class="return-page">
  <view class="return-icon {{failed ? 'failed' : ''}}">{{loading ? '…' : (failed ? '!' : '✓')}}</view>
  <view class="return-title">{{title}}</view>
  <view class="return-message">{{message}}</view>
  <button wx:if="{{failed}}" class="return-button" bindtap="syncResult">重新同步</button>
  <view class="return-message" wx:if="{{!loading && !failed}}">{{countdown}} 秒后{{options.scene === 'company' || (options.scene === 'personal' && options.flow !== 'company-create') ? '自动进入首页' : (options.scene === 'personal' ? '继续企业认证' : '返回业务页面')}}</view>
  <view class="return-link" bindtap="goBusinessPage" wx:if="{{!loading}}">{{failed ? '返回业务页面' : (options.scene === 'company' || (options.scene === 'personal' && options.flow !== 'company-create') ? '立即进入首页' : '立即继续')}}</view>
</view>
