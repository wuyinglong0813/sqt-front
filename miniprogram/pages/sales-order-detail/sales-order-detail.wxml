<view class="page">
  <view class="loading" wx:if="{{loading && !detail}}">加载单据中...</view>
  <view class="load-error" wx:if="{{loadError}}">
    <view>{{loadError}}</view>
    <button bindtap="loadAll" loading="{{loading}}" disabled="{{loading}}">重新加载</button>
  </view>
  <block wx:if="{{detail}}">
    <view class="hero">
      <view class="hero-head"><view class="hero-label">{{detail.title}}</view>
        <view class="document-more">
          <button class="document-more-button" bindtap="toggleDocumentMore" aria-label="更多单据操作" aria-expanded="{{showDocumentMore}}" disabled="{{loading || pdfLoading || actionLoading || publishing || deleting || receiving || draftSaving || memoSaving}}">更多</button>
          <view class="document-more-mask" wx:if="{{showDocumentMore}}" bindtap="closeDocumentMore"></view>
          <view class="document-more-menu" wx:if="{{showDocumentMore}}" catchtap="noop">
            <scroll-view scroll-y class="document-more-scroll">
              <button class="document-more-action {{item.tone}}" wx:for="{{documentMoreActions}}" wx:key="key" disabled="{{loading || pdfLoading || actionLoading || publishing || deleting || receiving || draftSaving || memoSaving}}" data-action="{{item.key}}" bindtap="runDocumentMoreAction"><text>{{item.label}}</text><text class="document-more-tip" wx:if="{{item.tip}}">{{item.tip}}</text></button>
            </scroll-view>
          </view>
        </view>
      </view>
      <view class="hero-no">{{documentNo}}</view>
      <view class="hero-row"><view>{{detail.companyName}} → {{detail.counterpartyName}}</view><view class="status {{detail.status === 'DRAFT' ? 'draft' : (detail.status === 'REJECTED' ? 'rejected' : '')}}">{{detail.statusText}}</view></view>
    </view>

    <view class="document-pdf-reader">
      <view class="document-pdf-page" wx:for="{{pdfPreviewPages}}" wx:key="pageNumber">
        <image class="document-pdf-image" wx:if="{{item.filePath && !item.error}}" src="{{item.filePath}}" mode="widthFix" lazy-load="{{true}}" data-page="{{item.pageNumber}}" binderror="onDocumentPreviewImageError" bindtap="viewPdf"/>
        <view class="document-preview-state" wx:elif="{{item.loading}}">加载中…</view>
        <view class="document-preview-state" wx:else><view>{{item.error}}</view><button data-page="{{item.pageNumber}}" disabled="{{pdfPreviewLoading}}" bindtap="retryDocumentPreview">重新加载此页</button></view>
      </view>
      <view class="document-preview-state" wx:if="{{pdfPreviewLoading && !pdfPreviewPages.length}}">{{documentLabel}}加载中…</view>
      <view class="document-preview-state" wx:elif="{{!pdfPreviewPages.length}}"><view>{{pdfPreviewError || 'PDF预览加载失败，请重试'}}</view><button disabled="{{pdfPreviewLoading}}" bindtap="retryDocumentPreview">重新加载</button></view>
      <view class="document-pdf-actions"><button class="primary" loading="{{pdfLoading}}" disabled="{{loading || pdfLoading}}" bindtap="viewPdf">查看 PDF</button><button class="secondary" loading="{{pdfLoading}}" disabled="{{loading || pdfLoading}}" bindtap="downloadDocumentPdf">下载 PDF</button></view>
    </view>

    <view class="document-state-note" wx:if="{{detail.status === 'REJECTED' && detail.rejectedReason}}">驳回原因：{{detail.rejectedReason}}</view>
    <view class="document-state-note" wx:if="{{activeAction && activeAction.reason}}">作废申请：{{activeAction.reason}}</view>
  </block>

  <view class="warehouse-mask" wx:if="{{showWarehousePicker}}" bindtap="closeWarehousePicker">
    <view class="warehouse-sheet" catchtap="noop">
      <view class="warehouse-handle"></view>
      <view class="warehouse-head"><view class="warehouse-title">{{warehousePickerTitle}}</view><view class="warehouse-close" bindtap="closeWarehousePicker">×</view></view>
      <view class="warehouse-tip">{{warehousePickerTip}}</view>
      <view class="warehouse-state" wx:if="{{warehousesLoading}}">正在加载仓库…</view>
      <view class="warehouse-state" wx:elif="{{warehousesError}}"><text>{{warehousesError}}</text><button bindtap="retryWarehouses">重新加载</button></view>
      <view class="warehouse-state" wx:elif="{{!warehouses.length}}"><view class="warehouse-empty-icon">仓</view><view class="warehouse-empty-title">还没有仓库</view><view>创建仓库后返回，即可继续办理</view></view>
      <scroll-view class="warehouse-list" scroll-y wx:else>
        <view class="warehouse-option {{selectedWarehouseId == item.id ? 'selected' : ''}}" wx:for="{{warehouses}}" wx:key="id" data-id="{{item.id}}" bindtap="selectWarehouse"><view class="warehouse-option-icon">仓</view><view class="warehouse-option-name">{{item.name}}</view><view class="warehouse-radio">{{selectedWarehouseId == item.id ? '✓' : ''}}</view></view>
      </scroll-view>
      <view class="warehouse-footer"><button class="warehouse-create" bindtap="createWarehouse">＋ 新建仓库</button><button class="warehouse-confirm" disabled="{{warehousesLoading || warehousesError || !selectedWarehouseId}}" bindtap="confirmWarehouse">确认选择</button></view>
    </view>
  </view>

  <view class="memo-mask" wx:if="{{showMemoEditor}}" bindtap="closeMemoEditor">
    <view class="memo-sheet" catchtap="noop">
      <view class="memo-sheet-handle"></view>
      <view class="memo-head"><view><view class="section-title">我的{{documentLabel}}进展</view><view class="memo-tip">仅当前账号可见，不与同事或对方共享</view></view><view class="memo-close" bindtap="closeMemoEditor">×</view></view>
      <textarea value="{{memoDraft}}" maxlength="4000" bindinput="onMemoInput" placeholder="记录接收、入库或后续处理进展…" focus="{{showMemoEditor && !detail.contractReadOnly}}" disabled="{{memoSaving || detail.contractReadOnly}}"/>
      <view class="memo-sheet-meta"><text>{{memoDraft.length}} / 4000</text><text wx:if="{{memoUpdatedAt}}">上次保存 {{memoUpdatedAt}}</text></view>
      <view class="memo-readonly" wx:if="{{detail.contractReadOnly}}">合同当前只读，可查看已有进展</view>
      <button class="memo-save" wx:else loading="{{memoSaving}}" disabled="{{memoSaving}}" bindtap="saveMemo">保存我的进展</button>
    </view>
  </view>

  <view class="signature-mask" wx:if="{{showSignatureEditor}}" bindtap="closeSignatureEditor">
    <view class="signature-sheet" catchtap="noop">
      <view class="signature-handle"></view>
      <view class="signature-head">
        <view><view class="signature-title">请手写签名</view><view class="signature-signer">签署人：{{signatureSignerName}}</view></view>
        <view class="signature-close" bindtap="closeSignatureEditor">×</view>
      </view>
      <view class="signature-canvas-wrap">
        <canvas
          type="2d"
          id="salesOrderSignatureCanvas"
          class="signature-canvas"
          disable-scroll="true"
          bindtouchstart="onSignatureTouchStart"
          catchtouchmove="onSignatureTouchMove"
          bindtouchend="onSignatureTouchEnd"
          bindtouchcancel="onSignatureTouchEnd"
        ></canvas>
        <view class="signature-placeholder">请在此区域签名</view>
      </view>
      <view class="signature-notice">签名会自动填写到{{documentLabel}} PDF 的“客户确认”位置</view>
      <view class="signature-actions">
        <button class="signature-clear" disabled="{{receiving}}" bindtap="clearSignature">清除重签</button>
        <button class="signature-confirm" loading="{{receiving}}" disabled="{{receiving}}" bindtap="confirmSignature">{{signatureActionText}}</button>
      </view>
    </view>
  </view>

  <view class="draft-editor-page" wx:if="{{showDraftEditor}}">
    <view class="draft-editor-header"><view bindtap="closeDraftEditor">取消</view><text>编辑{{documentLabel}}草稿</text><view class="placeholder">取消</view></view>
    <scroll-view class="draft-editor-body" scroll-y>
      <view class="card edit-card">
        <view class="edit-label">{{documentLabel}}名称</view>
        <input value="{{draftTitle}}" data-field="draftTitle" bindinput="onDraftFieldInput" placeholder="请输入单据名称"/>
      </view>
      <view class="card edit-card">
        <view class="section-title">单据信息</view>
        <view class="edit-row"><text>制单企业</text><input value="{{draftCompanyName}}" data-field="draftCompanyName" bindinput="onDraftFieldInput"/></view>
        <view class="edit-row"><text>往来单位</text><input value="{{draftCounterpartyName}}" data-field="draftCounterpartyName" bindinput="onDraftFieldInput"/></view>
        <view class="edit-row"><text>关联合同</text><input value="{{draftContractNo}}" data-field="draftContractNo" bindinput="onDraftFieldInput"/></view>
        <view class="edit-row"><text>单据日期</text><picker mode="date" value="{{draftDate}}" bindchange="onDraftDateChange"><view>{{draftDate || '请选择日期'}}</view></picker></view>
      </view>
      <view class="card edit-card">
        <view class="section-title">商品明细</view>
        <view class="edit-hint">左右滑动可编辑全部列</view>
        <scroll-view class="draft-table-scroll" scroll-x>
          <view class="draft-table" style="width: {{draftColumns.length * 190 + 78}}rpx;">
            <view class="draft-table-row header"><view wx:for="{{draftColumns}}" wx:key="*this">{{item}}</view><view class="action"></view></view>
            <view class="draft-table-row {{draftRowTypes[rowIndex] === 'FEE' ? 'fee-row' : ''}}" wx:for="{{draftRows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex">
              <view wx:for="{{draftColumns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="*this"><input value="{{row[columnIndex]}}" data-row="{{rowIndex}}" data-col="{{columnIndex}}" bindinput="onDraftCellInput"/></view>
              <view class="action"><text data-index="{{rowIndex}}" bindtap="deleteDraftRow">×</text></view>
            </view>
          </view>
        </scroll-view>
        <view class="add-row" bindtap="addDraftRow">＋ 添加商品行</view>
        <view class="draft-total">合计：<text>¥{{draftTotalAmount}}</text></view>
      </view>
      <view class="draft-editor-safe"></view>
    </scroll-view>
    <view class="draft-editor-footer"><button loading="{{draftSaving}}" disabled="{{draftSaving}}" bindtap="saveDraft">保存草稿</button></view>
  </view>
</view>
