page { background: #f4f8fd; }
.page { min-height: 100vh; padding-bottom: calc(34rpx + env(safe-area-inset-bottom)); }
.loading { color: #94a0ae; font-size: 25rpx; padding: 120rpx 0; text-align: center; }
.load-error { color: #7c8897; font-size: 25rpx; padding: 70rpx 30rpx; text-align: center; }
.load-error button { background: #e6f2ff; border: 0; border-radius: 14rpx; color: #267ed7; font-size: 25rpx; margin: 28rpx auto 0; width: 240rpx; }
.hero { background: linear-gradient(138deg,#45a8ff,#2478df); color: #fff; padding: 34rpx 30rpx 40rpx; }
.hero-head { align-items: center; display: flex; gap: 20rpx; justify-content: space-between; }
.hero-label { color: rgba(255,255,255,.8); flex: 1; font-size: 24rpx; min-width: 0; overflow-wrap: anywhere; }
.hero-no { font-size: 36rpx; font-weight: 700; margin-top: 8rpx; overflow-wrap: anywhere; }
.hero-row { align-items: flex-start; display: flex; font-size: 22rpx; gap: 18rpx; justify-content: space-between; line-height: 1.6; margin-top: 16rpx; }
.hero-row > view:first-child { min-width: 0; overflow-wrap: anywhere; }
.status { background: rgba(255,255,255,.2); border-radius: 15rpx; flex-shrink: 0; padding: 5rpx 13rpx; }
.status.draft { background: #fff2ce; color: #a96a00; }
.status.rejected { background: #fde5e5; color: #aa3434; }
.reject-reason { color: #b23e3e; font-weight: 600; margin: 10rpx 0; }
.document-more { flex-shrink: 0; position: relative; z-index: 142; }
.document-more-button { align-items: center; background: rgba(255,255,255,.13); border: 1rpx solid rgba(255,255,255,.2); border-radius: 24rpx; color: #fff; display: flex; font-size: 24rpx; height: 64rpx; justify-content: center; line-height: 1; margin: 0; padding: 0 20rpx; width: 112rpx; }
.document-more-button[disabled] { background: rgba(255,255,255,.1); color: rgba(255,255,255,.6); }
.document-more-mask { bottom: 0; left: 0; position: fixed; right: 0; top: 0; z-index: 141; }
.document-more-menu { background: #fff; border: 1rpx solid #e7edf5; border-radius: 18rpx; box-shadow: 0 12rpx 40rpx rgba(21,54,89,.15); overflow: hidden; position: absolute; right: 0; top: 78rpx; width: 344rpx; z-index: 142; }
.document-more-scroll { max-height: 65vh; }
.document-more-action { background: #fff; border: 0; border-radius: 0; color: #30465e; font-size: 25rpx; line-height: 1.5; margin: 0; padding: 22rpx 28rpx; text-align: left; width: 100%; }
.document-more-action:active { background: #f3f8fe; }
.document-more-action.caution { color: #b56870; }
.document-more-action.primary { color: #2989e5; font-weight: 600; }
.document-more-action.danger { color: #ce4d58; }
.document-more-action[disabled] { background: #fff; color: #a4b0be; }
.document-more-tip { color: #99a6b5; font-size: 19rpx; margin-left: 14rpx; }
.document-pdf-reader { margin: 24rpx 24rpx 0; }
.document-pdf-page { background: #fff; margin-bottom: 18rpx; overflow: hidden; }
.document-pdf-image { display: block; width: 100%; }
.document-preview-state { align-items: center; background: #fff; border-radius: 14rpx; color: #8b9bad; display: flex; flex-direction: column; font-size: 24rpx; justify-content: center; line-height: 1.7; min-height: 260rpx; padding: 36rpx 28rpx; text-align: center; }
.document-preview-state button { background: #eaf4ff; border-radius: 12rpx; color: #2989e5; font-size: 24rpx; margin-top: 24rpx; padding: 0 26rpx; }
.document-pdf-actions { display: grid; gap: 16rpx; grid-template-columns: 1fr 1fr; margin-top: 22rpx; }
.document-pdf-actions button { border: 0; border-radius: 14rpx; font-size: 25rpx; height: 76rpx; line-height: 76rpx; margin: 0; }
.document-pdf-actions .primary { background: #3498ff; color: #fff; }
.document-pdf-actions .secondary { background: #eaf4ff; color: #2989e5; }
.card,.receive-card { background: #fff; border: 1rpx solid #e1eaf4; border-radius: 20rpx; margin: 20rpx 24rpx 0; padding: 24rpx; }
.draft-notice {
  background: #fff; border: 1rpx solid #dce9f7; border-radius: 20rpx; color: #7b8ca0;
  font-size: 22rpx; line-height: 1.65; margin: 20rpx 24rpx 0; padding: 24rpx;
}
.draft-notice-head { align-items: center; display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.draft-notice-icon { background: #eaf4ff; border-radius: 11rpx; color: #2989e5; font-size: 22rpx; font-weight: 600; padding: 3rpx 12rpx; }
.draft-notice-title { color: #203349; flex: 1; font-size: 27rpx; font-weight: 700; }
.draft-notice-tag { color: #8b9bad; font-size: 18rpx; }
.draft-notice.is-rejected .draft-notice-icon { background: #fff0f0; color: #c64747; }
.draft-submit { background: #3498ff; border: 0; border-radius: 13rpx; color: #fff; font-size: 24rpx; line-height: 70rpx; margin: 22rpx 0 0; width: 100%; }
.draft-actions { display: grid; gap: 14rpx; grid-template-columns: repeat(2,minmax(0,1fr)); margin-top: 18rpx; }
.draft-actions button { border: 0; border-radius: 13rpx; font-size: 23rpx; height: 66rpx; line-height: 66rpx; margin: 0; }
.draft-actions .secondary { background: #eaf4ff; color: #2989e5; }
.draft-actions .primary { background: #3498ff; color: #fff; }
.draft-actions .danger { background: #fff0f1; color: #ce4d58; }
.receive-actions { display: grid; gap: 14rpx; grid-template-columns: 1fr 1fr; margin-top: 20rpx; }
.receive-actions button,.memo-save { border: 0; border-radius: 13rpx; font-size: 23rpx; height: 68rpx; line-height: 68rpx; margin: 0; }
.receive-actions .primary { background: #3498ff; color: #fff; }
.receive-actions .secondary,.memo-save { background: #eaf4ff; color: #2989e5; }
.receive-actions .primary:last-child:nth-child(3) { grid-column: 1 / -1; }
button::after { border: 0; }
.section-title { color: #203349; font-size: 28rpx; font-weight: 700; }
.draft-table-row.fee-row > view { background: #fff8ed; }
.memo-mask { align-items: flex-end; background: rgba(11,25,43,.45); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 260; }
.memo-sheet { background: #fff; border-radius: 30rpx 30rpx 0 0; box-sizing: border-box; padding: 16rpx 28rpx calc(26rpx + env(safe-area-inset-bottom)); width: 100%; }
.memo-sheet-handle { background: #dce3eb; border-radius: 4rpx; height: 7rpx; margin: 0 auto 24rpx; width: 74rpx; }
.memo-head { align-items: flex-start; display: flex; justify-content: space-between; }
.memo-tip { color: #9aa6b3; font-size: 19rpx; margin-top: 5rpx; }
.memo-close { color: #8d9baa; font-size: 42rpx; line-height: 38rpx; padding: 0 8rpx; }
.memo-sheet textarea { background: #f7f9fc; border: 1rpx solid #e5ecf4; border-radius: 12rpx; box-sizing: border-box; font-size: 24rpx; height: 300rpx; line-height: 1.6; margin-top: 16rpx; padding: 17rpx; width: 100%; }
.memo-sheet-meta { color: #a0abb7; display: flex; font-size: 18rpx; justify-content: space-between; margin-top: 9rpx; }
.memo-save { margin-top: 14rpx; width: 100%; }
.memo-readonly { color: #99a6b5; font-size: 21rpx; margin-top: 18rpx; text-align: center; }
.receive-card { border-color: #cfe6ff; }
.receive-title { color: #1e72c8; font-size: 28rpx; font-weight: 700; }
.receive-tip { color: #7f8e9f; font-size: 21rpx; line-height: 1.6; margin-top: 8rpx; }
.done-tip { color: #289660; font-size: 23rpx; padding: 28rpx; text-align: center; }
.done-tip.voided { color: #8b5d5d; }
.action-notice { background: #fff; border: 1rpx solid #dce9f7; border-radius: 20rpx; color: #7b8ca0; font-size: 22rpx; line-height: 1.65; margin: 20rpx 24rpx; padding: 24rpx; }
.action-notice-title { color: #203349; font-size: 26rpx; font-weight: 700; margin-bottom: 8rpx; }
.warehouse-mask { align-items: flex-end; background: rgba(16,35,59,.42); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 270; }
.warehouse-sheet { background: #fff; border-radius: 32rpx 32rpx 0 0; box-sizing: border-box; padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); width: 100%; }
.warehouse-handle { background: #dce6f0; border-radius: 4rpx; height: 7rpx; margin: 0 auto 24rpx; width: 68rpx; }
.warehouse-head { align-items: center; display: flex; justify-content: space-between; }
.warehouse-title { color: #203349; font-size: 31rpx; font-weight: 700; }
.warehouse-close { color: #8b9bad; font-size: 42rpx; line-height: 42rpx; padding: 0 6rpx; }
.warehouse-tip { color: #8595a7; font-size: 22rpx; line-height: 1.6; margin: 12rpx 0 24rpx; }
.warehouse-list { max-height: 48vh; }
.warehouse-option { align-items: center; background: #f7f9fc; border: 2rpx solid #f0f4f9; border-radius: 18rpx; box-sizing: border-box; display: flex; gap: 18rpx; margin-bottom: 14rpx; padding: 22rpx; }
.warehouse-option.selected { background: #eff7ff; border-color: #3498ff; }
.warehouse-option-icon,.warehouse-empty-icon { background: #e4f1ff; border-radius: 12rpx; color: #2989e5; font-size: 24rpx; padding: 10rpx 14rpx; }
.warehouse-option-name { color: #30465e; flex: 1; font-size: 26rpx; overflow-wrap: anywhere; }
.warehouse-radio { align-items: center; border: 2rpx solid #ccd9e7; border-radius: 50%; color: #fff; display: flex; flex-shrink: 0; font-size: 22rpx; height: 34rpx; justify-content: center; width: 34rpx; }
.selected .warehouse-radio { background: #3498ff; border-color: #3498ff; }
.warehouse-state { color: #8b9bad; font-size: 23rpx; padding: 40rpx 0; text-align: center; }
.warehouse-state button { background: #eaf4ff; color: #2989e5; font-size: 24rpx; margin: 20rpx auto 0; width: 240rpx; }
.warehouse-empty-icon { display: inline-block; font-size: 36rpx; margin-bottom: 14rpx; }
.warehouse-empty-title { color: #30465e; font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.warehouse-footer { border-top: 1rpx solid #edf2f8; display: flex; gap: 18rpx; margin-top: 18rpx; padding-top: 24rpx; }
.warehouse-footer button { border-radius: 16rpx; flex: 1; font-size: 25rpx; height: 78rpx; line-height: 78rpx; margin: 0; }
.warehouse-create { background: #eaf4ff; color: #2989e5; }
.warehouse-confirm { background: #3498ff; color: #fff; }
.warehouse-confirm[disabled] { background: #edf2f8; color: #a5b3c2; }
.signature-mask { align-items: flex-end; background: rgba(11,25,43,.5); bottom: 0; display: flex; left: 0; position: fixed; right: 0; top: 0; z-index: 280; }
.signature-sheet { background: #fff; border-radius: 30rpx 30rpx 0 0; box-sizing: border-box; padding: 15rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); width: 100%; }
.signature-handle { background: #dce3eb; border-radius: 4rpx; height: 7rpx; margin: 0 auto 22rpx; width: 74rpx; }
.signature-head { align-items: flex-start; display: flex; justify-content: space-between; }
.signature-title { color: #203349; font-size: 31rpx; font-weight: 700; }
.signature-signer { color: #8c99a8; font-size: 21rpx; margin-top: 6rpx; }
.signature-close { color: #8d9baa; font-size: 42rpx; line-height: 38rpx; padding: 0 8rpx; }
.signature-canvas-wrap { background: #fff; border: 2rpx dashed #b9c9d9; border-radius: 15rpx; height: 300rpx; margin-top: 22rpx; overflow: hidden; position: relative; }
.signature-canvas { height: 100%; position: relative; width: 100%; z-index: 2; }
.signature-placeholder { bottom: 13rpx; color: #a5b0bc; font-size: 19rpx; left: 0; pointer-events: none; position: absolute; right: 0; text-align: center; z-index: 1; }
.signature-notice { color: #8d9aa9; font-size: 20rpx; margin-top: 12rpx; text-align: center; }
.signature-actions { display: grid; gap: 14rpx; grid-template-columns: .8fr 1.5fr; margin-top: 20rpx; }
.signature-actions button { border: 0; border-radius: 13rpx; font-size: 23rpx; height: 72rpx; line-height: 72rpx; margin: 0; }
.signature-clear { background: #edf4fb; color: #65778a; }
.signature-confirm { background: #3498ff; color: #fff; }

.draft-editor-page { background: #f4f8fd; bottom: 0; display: flex; flex-direction: column; left: 0; position: fixed; right: 0; top: 0; z-index: 240; }
.draft-editor-header { align-items: center; background: #fff; border-bottom: 1rpx solid #e1eaf4; color: #3498ff; display: flex; flex-shrink: 0; font-size: 25rpx; justify-content: space-between; padding: 24rpx 28rpx; }
.draft-editor-header text { color: #203349; font-size: 30rpx; font-weight: 700; }
.draft-editor-header .placeholder { visibility: hidden; }
.draft-editor-body { flex: 1; min-height: 0; }
.edit-card { margin-top: 18rpx; }
.edit-label { color: #8b98a7; font-size: 22rpx; margin-bottom: 10rpx; }
.edit-card > input { color: #26394f; font-size: 28rpx; font-weight: 600; width: 100%; }
.edit-row { align-items: center; border-bottom: 1rpx solid #edf2f7; display: flex; padding: 18rpx 0; }
.edit-row:last-child { border-bottom: 0; }
.edit-row > text { color: #7d8a99; flex-shrink: 0; font-size: 23rpx; width: 160rpx; }
.edit-row input,.edit-row picker { color: #26394f; flex: 1; font-size: 24rpx; }
.edit-hint { color: #9ba7b4; font-size: 19rpx; margin-top: 5rpx; }
.draft-table-scroll { margin-top: 16rpx; width: 100%; }
.draft-table { border-left: 1rpx solid #dfe8f2; border-top: 1rpx solid #dfe8f2; }
.draft-table-row { display: flex; }
.draft-table-row > view { align-items: center; border-bottom: 1rpx solid #dfe8f2; border-right: 1rpx solid #dfe8f2; box-sizing: border-box; display: flex; flex: 0 0 190rpx; justify-content: center; min-height: 70rpx; padding: 7rpx; }
.draft-table-row.header > view { background: #eaf4ff; color: #2585df; font-size: 21rpx; font-weight: 600; }
.draft-table-row > view.action { flex-basis: 78rpx; }
.draft-table-row input { background: #fafafa; border-radius: 6rpx; box-sizing: border-box; font-size: 23rpx; min-height: 54rpx; text-align: center; width: 100%; }
.draft-table-row .action text { align-items: center; background: #fff0f1; border-radius: 50%; color: #db5865; display: flex; font-size: 25rpx; height: 42rpx; justify-content: center; width: 42rpx; }
.add-row { background: #eaf4ff; border: 1rpx dashed #3498ff; border-radius: 10rpx; color: #3498ff; font-size: 24rpx; margin-top: 16rpx; padding: 14rpx; text-align: center; }
.draft-total { color: #667588; font-size: 25rpx; margin-top: 18rpx; text-align: right; }
.draft-total text { color: #e06139; font-size: 30rpx; font-weight: 700; }
.draft-editor-safe { height: 130rpx; }
.draft-editor-footer { background: #fff; border-top: 1rpx solid #e1eaf4; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); }
.draft-editor-footer button { background: linear-gradient(90deg,#3498ff,#45a8ff); border: 0; border-radius: 44rpx; color: #fff; font-size: 29rpx; height: 88rpx; line-height: 88rpx; margin: 0; }

.document-state-note { color: #8b9bad; font-size: 23rpx; line-height: 1.7; margin: 24rpx 30rpx 0; overflow-wrap: anywhere; }
