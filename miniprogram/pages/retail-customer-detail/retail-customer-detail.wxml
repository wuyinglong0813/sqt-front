<view class="retail-page">
  <view class="retail-error" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{customer}}">
    <view class="retail-card">
      <view class="retail-head"><view class="retail-title">{{customer.name}}</view><view class="retail-badge">{{customer.typeText}}</view></view>
      <view class="retail-sub">{{customer.contact || '未填写联系人'}} · {{customer.phone || '未填写电话'}}</view>
      <view class="retail-sub" wx:if="{{customer.address}}">{{customer.address}}</view>
      <view class="retail-grid"><view class="retail-stat"><view class="retail-stat-label">{{terms.order}}累计金额</view><view class="retail-stat-value">¥{{customer.tradeAmountText}}</view></view><view class="retail-stat"><view class="retail-stat-label">退货累计金额</view><view class="retail-stat-value">¥{{customer.returnAmountText}}</view></view></view>
      <view class="retail-info"><view class="retail-info-label">净{{terms.action}}金额</view><view class="retail-info-value">¥{{customer.netTradeAmountText}}</view></view>
      <view class="retail-actions" wx:if="{{customer.canEdit}}"><button class="retail-primary" data-type="{{terms.orderType}}" bindtap="createDocument">＋ 开{{terms.order}}</button><button class="retail-secondary" data-type="{{terms.returnType}}" bindtap="createDocument">开{{terms.returnOrder}}</button></view>
      <view class="retail-link" wx:if="{{customer.canEdit}}" bindtap="editCustomer">编辑{{terms.party}}资料 ›</view>
    </view>
    <view class="retail-card">
      <view class="retail-tabs"><view class="retail-tab {{activeTab === terms.orderType ? 'active' : ''}}" data-type="{{terms.orderType}}" bindtap="switchTab">{{terms.order}}</view><view class="retail-tab {{activeTab === terms.returnType ? 'active' : ''}}" data-type="{{terms.returnType}}" bindtap="switchTab">{{terms.returnOrder}}</view></view>
      <view class="retail-orderrow" wx:for="{{documents}}" wx:key="id" data-id="{{item.id}}" bindtap="openDocument"><view class="retail-head"><view class="retail-name">{{item.documentNo}}</view><view class="retail-badge {{item.status}}">{{item.statusText}}</view></view><view class="retail-info"><view class="retail-info-label">{{item.orderDate}}</view><view class="retail-orderamount">{{item.isReturn ? '−' : ''}}¥{{item.amountText}}</view></view></view>
      <view class="retail-loading" wx:if="{{loading}}">加载中…</view><view class="retail-empty" wx:elif="{{documents.length === 0 && !error}}">暂无{{activeTab === terms.orderType ? terms.order : terms.returnOrder}}</view>
    </view>
    <view class="retail-footer-note">单据由本公司确认生效，{{terms.party}}无需线上确认。退货冲减净{{terms.action}}额，退款另行记录。</view>
  </block>
</view>
