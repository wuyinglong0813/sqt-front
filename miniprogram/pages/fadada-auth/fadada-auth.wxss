page { background: #f4f8fd; }
.state-page { align-items: center; box-sizing: border-box; display: flex; flex-direction: column; min-height: 100vh; padding: 210rpx 52rpx 60rpx; text-align: center; }
.state-icon { align-items: center; background: #eaf4ff; border-radius: 50%; color: #318ce5; display: flex; font-size: 42rpx; font-weight: 700; height: 104rpx; justify-content: center; width: 104rpx; }
.state-icon.error { background: #fff0f0; color: #d3545b; }
.loading-ring { border: 7rpx solid #d7ebff; border-top-color: #318ce5; box-sizing: border-box; animation: spin 1s linear infinite; }
.state-title { color: #1b2b3f; font-size: 31rpx; font-weight: 700; margin-top: 30rpx; }
.state-desc { color: #8190a2; font-size: 23rpx; line-height: 1.6; margin-top: 13rpx; }
.primary-button { background: linear-gradient(90deg,#45a8ff,#2788ec); border-radius: 24rpx; color: #fff; font-size: 26rpx; height: 86rpx; line-height: 86rpx; margin-top: 40rpx; width: 100%; }
.primary-button::after { border: none; }
.back-link { color: #66809b; font-size: 24rpx; margin-top: 30rpx; padding: 12rpx; }
.preparation-page { padding-top: 130rpx; }
.preparation-page .state-desc { color: #61758b; font-size: 25rpx; line-height: 1.8; margin-top: 24rpx; }
.preparation-page .back-link { margin-top: 18rpx; }
.quota-page { box-sizing: border-box; min-height: 100vh; padding: 64rpx 32rpx 60rpx; background: linear-gradient(180deg, #eaf3ff 0, #f5f8fc 480rpx); }
.quota-card { box-sizing: border-box; width: 100%; max-width: 760rpx; margin: 0 auto; padding: 36rpx 36rpx 40rpx; border: 1rpx solid #e5edf7; border-radius: 32rpx; background: #fff; box-shadow: 0 16rpx 50rpx rgba(50, 90, 140, .06); text-align: center; }
.quota-service-label { color: #6f8299; font-size: 23rpx; letter-spacing: 2rpx; }
.quota-illustration { position: relative; width: 172rpx; height: 172rpx; border-radius: 50%; margin: 36rpx auto 30rpx; background: #f0f6ff; display: flex; align-items: center; justify-content: center; }
.quota-document { box-sizing: border-box; width: 88rpx; height: 110rpx; padding: 28rpx 16rpx 0; background: #fff; border: 3rpx solid #83b7f3; border-radius: 12rpx; transform: rotate(-7deg); }
.quota-document-line { height: 6rpx; width: 40rpx; margin-bottom: 12rpx; border-radius: 4rpx; background: #bbd8f9; }
.quota-document-line.long { width: 50rpx; background: #72acf0; }
.quota-document-line.short { width: 28rpx; }
.quota-status-mark { position: absolute; right: 19rpx; bottom: 23rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 46rpx; height: 46rpx; border: 5rpx solid #fff; border-radius: 50%; background: #f3bb5c; color: #fff; font-size: 28rpx; font-weight: 700; font-family: Georgia, serif; }
.quota-title { color: #20334c; font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.quota-description { margin-top: 18rpx; color: #6b7d92; font-size: 26rpx; line-height: 1.8; overflow-wrap: break-word; }
.quota-primary { margin-top: 32rpx; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; }
.quota-footer { display: flex; align-items: center; justify-content: center; margin: 28rpx auto 0; }
.quota-footer-link { padding: 16rpx 20rpx; color: #7b8da3; font-size: 24rpx; }
/* The desktop signing window expands to 1280px; keep the notice readable. */
@media (min-width: 768px) {
  .quota-page { padding: 32px 16px 30px; background: linear-gradient(180deg, #eaf3ff 0, #f5f8fc 240px); }
  .quota-card { max-width: 380px; padding: 18px 18px 20px; border: 0.5px solid #e5edf7; border-radius: 16px; box-shadow: 0 8px 25px rgba(50, 90, 140, .06); }
  .quota-service-label { font-size: 11.5px; letter-spacing: 1px; }
  .quota-illustration { width: 86px; height: 86px; margin: 18px auto 15px; }
  .quota-document { width: 44px; height: 55px; padding: 14px 8px 0; border: 1.5px solid #83b7f3; border-radius: 6px; }
  .quota-document-line { height: 3px; width: 20px; margin-bottom: 6px; border-radius: 2px; }
  .quota-document-line.long { width: 25px; }
  .quota-document-line.short { width: 14px; }
  .quota-status-mark { right: 9.5px; bottom: 11.5px; width: 23px; height: 23px; border: 2.5px solid #fff; font-size: 14px; }
  .quota-title { font-size: 18px; }
  .quota-description { margin-top: 9px; font-size: 13px; }
  .quota-primary { height: 43px; line-height: 43px; margin-top: 16px; border-radius: 9px; font-size: 14px; }
  .quota-footer { margin: 14px auto 0; }
  .quota-footer-link { padding: 8px 10px; font-size: 12px; }
}
@keyframes spin { to { transform: rotate(360deg); } }
