<view class="approval-page">
  <view class="current-company">
    <view class="company-icon-shell"><image src="/images/icons/company.svg" mode="aspectFit"/></view>
    <view class="company-context">
      <view class="company-context-name">{{currentCompanyName}}</view>
      <view class="company-context-desc">当前企业</view>
    </view>
  </view>

  <view class="center-tabs">
    <view class="center-tab {{activeSection === item.key ? 'active' : ''}}"
      wx:for="{{sectionTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchSection">
      <text>{{item.label}}</text><text class="center-tab-count" wx:if="{{item.count > 0}}">{{item.count}}</text>
    </view>
  </view>

  <view class="approval-tabs" wx:if="{{activeSection === 'PENDING'}}">
    <view class="approval-tab {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">
      <text>{{item.label}}</text><text class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <view class="company-filter" wx:if="{{companyOptions.length > 1}}">
    <picker mode="selector" range="{{companyOptions}}" range-key="name" value="{{companyIndex}}" bindchange="selectCompany">
      <view class="company-picker">
        <view><view class="picker-label">按往来公司筛选</view><view class="picker-value">{{companyOptions[companyIndex].name}}</view></view>
        <view class="picker-arrow">⌄</view>
      </view>
    </picker>
  </view>

  <view class="loading-hint" wx:if="{{loading}}">审批中心加载中...</view>
  <view class="empty-hint" wx:elif="{{visibleGroups.length === 0}}">
    <image src="/images/icons/approval.svg" mode="aspectFit"/>
    <view class="empty-title" wx:if="{{activeSection === 'RESULT'}}">暂无处理记录</view>
    <view class="empty-title" wx:elif="{{activeTab === 'CONTRACT'}}">暂无待审批合同</view>
    <view class="empty-title" wx:else>暂无待审批履约资料</view>
  </view>

  <view class="approval-groups" wx:else>
    <view class="company-group" wx:for="{{visibleGroups}}" wx:key="companyId" wx:for-item="group">
      <view class="group-head">
        <view class="group-avatar">{{group.initial}}</view>
        <view class="group-copy">
          <view class="group-name">{{group.companyName}}</view>
          <view class="group-count">{{group.countText}}</view>
        </view>
      </view>

      <block wx:if="{{activeSection === 'RESULT'}}">
        <view class="result-list">
          <view class="result-card {{result.isRead ? 'read' : 'unread'}}"
            wx:for="{{group.items}}" wx:key="id" wx:for-item="result"
            data-item="{{result}}" bindtap="openResult">
            <view class="result-icon {{result.typeClass}} {{result.statusClass}}">{{result.iconText}}</view>
            <view class="result-copy">
              <view class="result-title-row">
                <view class="unread-dot" wx:if="{{!result.isRead}}"></view>
                <view class="result-title">{{result.title}}</view>
              </view>
              <view class="result-detail">{{result.detail}}</view>
              <view class="result-reason" wx:if="{{result.rejectedReason}}">原因：{{result.rejectedReason}}</view>
              <view class="result-time">{{result.timeText}}</view>
            </view>
            <view class="result-arrow" wx:if="{{result.canOpen}}">›</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{activeTab === 'CONTRACT'}}">
        <view class="approval-card" wx:for="{{group.items}}" wx:key="id" wx:for-item="contract">
          <view class="card-top">
            <view class="type-icon contract">合</view>
            <view class="card-copy">
              <view class="card-title">{{contract.name}}</view>
              <view class="card-meta">{{contract.contractNo}} · {{contract.createdDate}}</view>
            </view>
            <view class="pending-badge">待签署</view>
          </view>
          <view class="contract-summary">
            <view><text>合同金额</text><view class="summary-strong">¥{{contract.amountText}}</view></view>
            <view><text>合同期限</text><view class="summary-strong">{{contract.startDate || '—'}} 至 {{contract.endDate || '—'}}</view></view>
          </view>
          <view class="card-actions">
            <button class="action ghost" data-contract="{{contract}}" catchtap="viewContract">查看合同</button>
            <button class="action reject" wx:if="{{contract.perspective !== 'OUTGOING'}}" data-contract="{{contract}}" catchtap="reject">拒绝</button>
            <button class="action primary" data-contract="{{contract}}" catchtap="approve">签署合同</button>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="approval-card fulfillment-card" wx:for="{{group.items}}" wx:key="id" wx:for-item="document">
          <view class="card-top">
            <view class="type-icon {{document.typeClass}}">{{document.iconText}}</view>
            <view class="card-copy">
              <view class="card-title">{{document.typeText}} · {{document.documentNo}}</view>
              <view class="card-meta">合同编号：{{document.contractNo || '—'}}</view>
              <view class="card-meta">合同名称：{{document.contractName || '—'}}</view>
              <view class="card-meta"><text wx:if="{{document.dateText}}">{{document.dateText}}</text><text wx:if="{{document.amountText}}"> · ¥{{document.amountText}}</text></view>
              <view class="signature-hint" wx:if="{{document.approvalType === 'SALES_ORDER' || document.approvalType === 'RETURN_ORDER' || document.approvalType === 'PAYMENT_VOUCHER'}}">确认时需要手写签名</view>
            </view>
            <view class="pending-badge">待确认</view>
          </view>
          <view class="action-reason" wx:if="{{document.approvalType === 'BILATERAL_ACTION'}}">申请原因：{{document.reason}}</view>
          <view class="card-actions single" wx:if="{{document.approvalType === 'SALES_ORDER' || document.approvalType === 'RETURN_ORDER'}}">
            <button class="action primary" data-item="{{document}}" catchtap="openFulfillment">查看并确认</button>
          </view>
          <view class="card-actions" wx:elif="{{document.approvalType === 'BILATERAL_ACTION'}}">
            <button class="action ghost" data-item="{{document}}" catchtap="openFulfillment">查看业务</button>
            <button class="action reject" data-item="{{document}}" data-decision="REJECT" catchtap="reviewBilateralAction">拒绝</button>
            <button class="action primary" data-item="{{document}}" data-decision="APPROVE" catchtap="reviewBilateralAction">确认{{document.actionType === 'END' ? '结束' : '作废'}}</button>
          </view>
          <view class="card-actions" wx:else>
            <button class="action ghost" data-item="{{document}}" catchtap="viewAttachment">查看资料</button>
            <button class="action reject" data-item="{{document}}" catchtap="rejectAttachment">驳回</button>
            <button class="action primary" data-item="{{document}}" catchtap="approveAttachment">确认通过</button>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="signature-mask" wx:if="{{showAttachmentSignature}}" bindtap="closeAttachmentSignature">
    <view class="signature-sheet" catchtap="noop">
      <view class="signature-handle"></view>
      <view class="signature-head">
        <view>
          <view class="signature-title">确认转款凭证</view>
          <view class="signature-signer">确认人：{{attachmentSignatureSignerName}}</view>
        </view>
        <view class="signature-close" bindtap="closeAttachmentSignature">×</view>
      </view>
      <view class="signature-confirm-copy">请核对凭证内容后手写签名。查看资料时不会要求签名。</view>
      <view class="signature-canvas-wrap">
        <canvas
          type="2d"
          id="paymentVoucherSignatureCanvas"
          class="signature-canvas"
          disable-scroll="true"
          bindtouchstart="onAttachmentSignatureTouchStart"
          catchtouchmove="onAttachmentSignatureTouchMove"
          bindtouchend="onAttachmentSignatureTouchEnd"
          bindtouchcancel="onAttachmentSignatureTouchEnd"
        ></canvas>
        <view class="signature-placeholder">请在此区域签名</view>
      </view>
      <view class="signature-actions">
        <button class="signature-clear" disabled="{{attachmentDecisionLoading}}" bindtap="clearAttachmentSignature">清除重签</button>
        <button class="signature-confirm" loading="{{attachmentDecisionLoading}}" disabled="{{attachmentDecisionLoading}}" bindtap="confirmAttachmentSignature">签字并确认通过</button>
      </view>
    </view>
  </view>
</view>
