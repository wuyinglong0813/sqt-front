:host {
  display: block;
}

.tab-bar {
  background: #eef1f5;
  border-top: 1rpx solid rgba(24, 48, 78, 0.05);
  bottom: 0;
  box-shadow: 0 -8rpx 30rpx rgba(31, 55, 84, 0.07);
  left: 0;
  position: fixed;
  right: 0;
  z-index: 999;
}

.tab-bar-inner {
  display: flex;
  height: 104rpx;
  position: relative;
}

.tab-indicator {
  height: 100%;
  left: 0;
  pointer-events: none;
  position: absolute;
  top: 0;
  transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  width: 33.333333%;
  will-change: transform;
  z-index: 0;
}

.tab-indicator.without-transition {
  transition: none;
}

.tab-indicator-pill {
  background: #ffffff;
  border: 1rpx solid rgba(52, 152, 255, 0.06);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(29, 80, 135, 0.09);
  height: 82rpx;
  margin: 11rpx auto 0;
  width: 126rpx;
}

.tab-item {
  align-items: center;
  color: #9aa3a1;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  position: relative;
  transition: color 180ms ease, opacity 120ms ease;
  z-index: 1;
}

.tab-item:active {
  opacity: 0.68;
}

.tab-item.selected {
  color: #3498ff;
}

.tab-icon {
  height: 44rpx;
  width: 44rpx;
}

.tab-label {
  font-size: 20rpx;
  line-height: 27rpx;
  margin-top: 2rpx;
}

.tab-safe-area {
  height: env(safe-area-inset-bottom);
}
